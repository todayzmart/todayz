# Public build settings for the prod Pages builds (scripts/deploy/pages.sh). Nothing here is a
# secret: every value ends up in the shipped JS. The Turnstile site key is the `todayz-prod`
# widget (its secret stays in Cloudflare; the API reads it from Secrets Manager as
# TURNSTILE_SECRET_KEY).
VITE_API_URL=https://api.todayz.in
VITE_IMG_URL=https://img.todayz.in
VITE_TILES_URL=https://tiles.todayz.in
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFj6Q6j9e1vnXIkj
PUBLIC_API_URL=https://api.todayz.in
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFj6Q6j9e1vnXIkj
PUBLIC_CUSTOMER_APP_URL=https://app.todayz.in
PUBLIC_BUSINESS_APP_URL=https://business.todayz.in
