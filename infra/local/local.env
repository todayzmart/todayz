# TodayZ local defaults (W0-02). COMMITTED ON PURPOSE.
#
# Every value here is a local-only, non-secret default for `make dev` on a
# developer machine: loopback URLs, the Docker Postgres roles and MinIO
# stand-in credentials (literal in docker-compose.yml and postgres/init.sql),
# and mock-provider URLs. None of them works anywhere but 127.0.0.1, and
# staging/prod never read this file.
#
# Real secrets never go here. App keys (D-18) are generated into .env.local by
# `make setup`; provider keys, if you add your own, go in .env.local too.
# infra/local/proc.sh exports this file, then .env.local (which wins), into
# every host process. Every name here must be listed in .env.example, and no
# D-18 app key name may appear here (infra/local/test/static.sh checks both).
#
# Format: NAME=value, no quotes needed, no spaces around "=", no inline comments.

# --- Runtime and database ----------------------------------------------------
APP_ENV=local
# The API and workers connect as todayz_app (read/write, no DDL); migrations
# run as todayz_owner, which owns the schema. Both roles come from
# infra/local/postgres/init.sql. The superuser todayz is for make reset only.
DATABASE_URL=postgres://todayz_app:todayz_app@127.0.0.1:5433/todayz?sslmode=disable
DATABASE_MIGRATE_URL=postgres://todayz_owner:todayz_owner@127.0.0.1:5433/todayz?sslmode=disable
API_PUBLIC_URL=https://api.todayz.localhost

# --- Storage: MinIO stands in for R2 -----------------------------------------
R2_ENDPOINT=http://127.0.0.1:9100
R2_ACCESS_KEY_ID=todayz
R2_SECRET_ACCESS_KEY=todayz-local
R2_BUCKET_IMAGES=images
R2_BUCKET_PRIVATE=private
R2_BUCKET_TILES=tiles

# --- Telemetry: grafana/otel-lgtm --------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- Providers: the mocks server (W0-07) on 4010 ------------------------------
SMS_API_URL=http://127.0.0.1:4010/msg91
WHATSAPP_API_URL=http://127.0.0.1:4010/whatsapp
PUSH_API_URL=http://127.0.0.1:4010/push
TURNSTILE_API_URL=http://127.0.0.1:4010/turnstile
STT_API_URL=http://127.0.0.1:4010/sarvam
LLM_API_URL=http://127.0.0.1:4010/anthropic
MOCK_LLM=1

# --- Frontends (Vite; public values only) ------------------------------------
VITE_API_URL=https://api.todayz.localhost
# Cloudflare's published always-pass test site key: no script is loaded and the dummy token is sent.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TILES_URL=https://tiles.todayz.localhost
VITE_IMG_URL=https://img.todayz.localhost

# --- Marketing site (Astro; public values only) -------------------------------
# Cloudflare's published always-pass Turnstile test key. A production build of
# site/ fails without real values; verify-dist rejects this key outside e2e mode.
PUBLIC_API_URL=https://api.todayz.localhost
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_CUSTOMER_APP_URL=https://app.todayz.localhost
PUBLIC_BUSINESS_APP_URL=https://business.todayz.localhost
