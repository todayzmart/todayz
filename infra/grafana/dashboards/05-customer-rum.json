      "type": "text",
      "title": "How to read this",
      "datasource": null,
      "targets": [
        {
          "refId": "A"
        }
      ],
      "options": {
        "mode": "markdown",
        "content": "p75 is the number that matters (Core Web Vitals). Red cells are over budget. If a release line jumps, compare app versions and check `docs/runbooks/client-rum-regression.md`. JS errors: `docs/runbooks/client-errors.md`."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "table",
      "title": "p75 web vitals by route",
      "description": "p75 over the selected range per route template. Budgets: LCP 2.5 s, INP 200 ms, CLS 0.1, TTFB 800 ms (red above).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (route) (rate(tz_rum_lcp_seconds{app=~\"$app\"}[$__range])))",
          "legendFormat": "LCP",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
