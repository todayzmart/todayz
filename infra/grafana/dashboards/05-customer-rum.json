    {
      "type": "timeseries",
      "title": "JS errors per 1k page views",
      "description": "Client errors (including chunk-load failures) per 1000 page views. RUM has no session counter, so page views stand in for sessions; the alert line is 20 per 1k (≈ 2 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * sum(rate(tz_rum_errors_total{app=~\"$app\"}[$__rate_interval])) / histogram_count(sum(rate(tz_rum_lcp_seconds{app=~\"$app\"}[$__rate_interval])))",
          "legendFormat": "errors / 1k views",
          "range": true,
          "instant": false
