          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), count(*) AS sign_ins, count(*) FILTER (WHERE step_up_at IS NOT NULL) AS with_sms_step_up\nFROM sessions WHERE app = 'admin' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1 DESC"
