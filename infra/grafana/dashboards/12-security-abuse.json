          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(revoked_at, '10m'), count(*) AS reuse FROM sessions WHERE revoked_reason = 'reuse' AND $__timeFilter(revoked_at) GROUP BY 1 ORDER BY 1"
