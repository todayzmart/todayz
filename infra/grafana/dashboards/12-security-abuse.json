    {
      "type": "stat",
      "title": "Wrong-code attempts",
      "description": "Attempts on OTPs that were never verified.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(attempts), 0) AS value FROM otp_requests WHERE consumed_at IS NULL AND $__timeFilter(created_at)"
