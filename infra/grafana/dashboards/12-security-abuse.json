    {
      "type": "timeseries",
      "title": "OTP sends and verifies",
      "description": "OTP requests and how many were verified. Counts only; never an OTP.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '10m'), count(*) AS sends, count(*) FILTER (WHERE consumed_at IS NOT NULL) AS verified\nFROM otp_requests WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Verify success rate",
      "description": "Verified ÷ sent in range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg((consumed_at IS NOT NULL)::int) AS value FROM otp_requests WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
