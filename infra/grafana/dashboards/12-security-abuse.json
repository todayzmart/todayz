    {
      "type": "table",
      "title": "Offline counter-code links per store per day",
      "description": "Against pos_offline_links_risk_per_day (platform_settings, D-12).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, p.store_id, (p.offline_link_at AT TIME ZONE 'Asia/Kolkata')::date AS day, count(*) AS offline_links,\n       count(*) >= max((ps.value #>> '{}')::int) AS over_risk_line\nFROM pos_sales p JOIN stores s ON s.id = p.store_id, platform_settings ps\nWHERE p.offline_link_at IS NOT NULL AND $__timeFilter(p.offline_link_at) AND ps.key = 'pos_offline_links_risk_per_day'\nGROUP BY 1, 2, 3 ORDER BY 4 DESC LIMIT 20"
        }
