    {
      "type": "table",
      "title": "OTP sends by IP (hashed), top 10 per hour",
      "description": "Sends per hashed client address in the last hour (the alert line is 50/h). The hash is per address; the /24 grouping needs a prefix hash (TODO(lead)). Never the address itself.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT left(encode(ip_hash, 'hex'), 12) AS ip_key, count(*) AS sends, count(DISTINCT phone_hash) AS phones\nFROM otp_requests WHERE ip_hash IS NOT NULL AND created_at > now() - interval '1 hour' GROUP BY ip_hash ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
