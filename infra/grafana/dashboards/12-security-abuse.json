    {
      "type": "table",
      "title": "Code lockouts by store",
      "description": "Counter-code failures and lockouts per store.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, f.store_id, count(*) FILTER (WHERE f.cashier_locked_until IS NOT NULL OR f.phone_locked_until IS NOT NULL) AS lockouts, count(*) AS failures\nFROM counter_code_failures f JOIN stores s ON s.id = f.store_id WHERE $__timeFilter(f.failed_at) GROUP BY 1, 2 ORDER BY 3 DESC, 4 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "links": [
