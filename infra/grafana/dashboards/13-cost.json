    {
      "type": "stat",
      "title": "Cost per OTP verified (₹, 30 d)",
      "description": "SMS spend ÷ OTPs verified (all SMS counted).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT coalesce(sum(cost_paise), 0) FROM notification_deliveries WHERE channel = 'sms' AND created_at > now() - interval '30 days') / 100.0\n       / nullif((SELECT count(*) FROM otp_requests WHERE consumed_at IS NOT NULL AND created_at > now() - interval '30 days'), 0) AS value"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
