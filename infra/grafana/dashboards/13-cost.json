      "options": {
        "mode": "markdown",
        "content": "Notification cost is the provider's reported cost per delivery (`notification_deliveries.cost_paise`). AI per-feature detail is on 14. Locally every provider is a mock (D-17), so the numbers are the mock's."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Notification cost per day by channel (₹)",
      "description": "SMS, WhatsApp and push cost per IST day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), channel AS metric, sum(cost_paise) / 100.0 AS value\nFROM notification_deliveries WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "SMS today (₹)",
      "description": "SMS cost so far today (IST).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_paise), 0) / 100.0 AS value FROM notification_deliveries WHERE channel = 'sms' AND (created_at AT TIME ZONE 'Asia/Kolkata')::date = (now() AT TIME ZONE 'Asia/Kolkata')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        },
