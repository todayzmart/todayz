          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_paise), 0) / 100.0 AS value FROM notification_deliveries WHERE created_at > now() - interval '30 days'"
