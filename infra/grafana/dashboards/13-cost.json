          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT channel, provider, count(*) AS deliveries, sum(cost_paise) / 100.0 AS rupees FROM notification_deliveries WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 4 DESC"
