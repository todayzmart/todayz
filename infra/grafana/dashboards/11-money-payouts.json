  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "datasource": null,
      "targets": [
        {
          "refId": "A"
        }
      ],
      "options": {
        "mode": "markdown",
        "content": "Ledger reconcile must say OK. Credits are whole credits (1 credit = ₹1). Runbooks: `docs/runbooks/ledger-invariant.md`, `docs/runbooks/credits-ledger.md`."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Ledger reconcile (latest run)",
      "description": "1 = the latest ledger_reconcile run succeeded (no drift); 0 = it failed. The drift itself alerts (ledger-invariant).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN status = 'succeeded' THEN 1 ELSE 0 END AS value FROM job_runs WHERE kind = 'ledger_reconcile'\nAND status IN ('succeeded', 'failed', 'discarded') ORDER BY created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK"
                },
                "0": {
                  "text": "DRIFT"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Store credit balance (Σ)",
      "description": "Sum of store credit accounts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(balance), 0) AS value FROM account_balances WHERE kind = 'store_credit'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Negative store balances",
      "description": "Stores that owe the platform.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM account_balances WHERE kind = 'store_credit' AND balance < 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Credits held now",
      "description": "Credits reserved on open orders and bill claims.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(amount - captured - released), 0) AS value FROM credit_holds WHERE status = 'held'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Top 20 store credit balances",
      "description": "Largest store credit balances by size (negative = owes the platform).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, s.id AS store_id, b.balance FROM account_balances b JOIN ledger_accounts a ON a.id = b.account_id\nJOIN stores s ON s.id = a.owner_id WHERE a.kind = 'store_credit' ORDER BY abs(b.balance) DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "links": [
            {
              "title": "Open the store in admin",
              "url": "https://admin.todayz.localhost/stores/${__data.fields.store_id}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Holds by reason and status (range)",
      "description": "Credit holds created in range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN order_id IS NOT NULL THEN 'order' WHEN bill_claim_id IS NOT NULL THEN 'bill claim' ELSE 'other' END AS reason, status,\n       count(*) AS holds, sum(amount) AS credits FROM credit_holds WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Ledger transactions per day by kind",
      "description": "Every posting by kind (cashback, referral_reward, expiry, admin_adjustment, payout, …).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), kind AS metric, count(*) AS value FROM ledger_transactions WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Manual adjustments by admin (range)",
      "description": "Who adjusted balances by hand (audited; two-person approval applies above the limit, D-05).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.created_by AS admin_user_id, count(*) AS adjustments, sum(abs(e.amount)) / 2 AS credits_moved\nFROM ledger_transactions t JOIN ledger_entries e ON e.transaction_id = t.id WHERE t.kind = 'admin_adjustment' AND $__timeFilter(t.created_at)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "POS reversals (range)",
      "description": "Reversed POS sales with credits returned and cashback clawed back (D-08).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, p.store_id, count(*) AS reversals, sum(p.credits_used) AS credits_returned, sum(p.cashback_credits) AS cashback_clawed_back\nFROM pos_sales p JOIN stores s ON s.id = p.store_id WHERE p.reversed_at IS NOT NULL AND $__timeFilter(p.reversed_at) GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Statements by month and status",
      "description": "The monthly statements of the last 12 months, whatever the range (they close on the 1st at 00:30 IST). Credits are whole credits; computed payout is what the close put into the business's payout.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(period, 'YYYY-MM') AS month, status, count(*) AS statements, sum(closing) AS closing_credits,\n  coalesce(sum(computed_payout), 0) AS computed_payout_credits, count(*) FILTER (WHERE closing < 0) AS negative_closing\nFROM payout_statements WHERE period >= date_trunc('month', now() AT TIME ZONE 'Asia/Kolkata')::date - interval '11 months'\nGROUP BY 1, 2 ORDER BY 1 DESC, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Payouts: open now and paid in range",
      "description": "Pending and held payouts as they stand now (at most one open per business, D-09), by hold reason, with the oldest one's age; then the payouts marked paid in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status, coalesce(hold_reason, '') AS hold_reason, count(*) AS payouts, sum(amount) AS credits,\n  extract(epoch FROM now() - min(computed_at)) AS oldest_age\nFROM payouts WHERE status IN ('pending', 'held') GROUP BY 1, 2\nUNION ALL SELECT 'paid in range', '', count(*), coalesce(sum(amount), 0), NULL FROM payouts WHERE status = 'paid' AND $__timeFilter(paid_at)\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 29,
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Two-person approvals (D-05)",
      "description": "Wallet adjustments above admin_adjust_dual_approval_above_paise that wait for a second finance or super_admin: every pending request, whatever its age, and the ones requested in range by outcome.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status, count(*) AS requests, sum(abs(amount)) AS credits,\n  extract(epoch FROM max(now() - requested_at) FILTER (WHERE status = 'pending')) AS oldest_pending_age\nFROM admin_adjustment_requests WHERE status = 'pending' OR $__timeFilter(requested_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_pending_age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 30,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "stat",
      "title": "Wallet forfeits on account deletion (range)",
      "description": "Accounts deleted with credits left in the wallet, and the credits forfeited (D-31; ledger kind forfeit_deletion).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT t.id) AS forfeits, coalesce(sum(abs(e.amount)) / 2, 0) AS credits\nFROM ledger_transactions t JOIN ledger_entries e ON e.transaction_id = t.id\nWHERE t.kind = 'forfeit_deletion' AND $__timeFilter(t.created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 31,
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 7
      }
    }
  ]
}
