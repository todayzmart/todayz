    {
      "type": "timeseries",
      "title": "POS sales: offline vs online",
      "description": "Completed POS sales per hour; offline ones were rung up without the network and synced later.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(sold_at, '1h'), count(*) FILTER (WHERE offline) AS offline, count(*) FILTER (WHERE NOT offline) AS online\nFROM v_metric_pos_sales WHERE $__timeFilter(sold_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Sync lag p50 / p95 (sale → server)",
      "description": "Seconds from the sale on the device to the server receiving it, offline sales only. Target: 99 % within 2 min of coming online (05 §6).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(received_at, '1h'),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM received_at - sold_at)) AS p50,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM received_at - sold_at)) AS p95\nFROM pos_sales WHERE device_seq IS NOT NULL AND $__timeFilter(received_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 16,
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Devices with sync older than 1 h",
      "description": "POS devices of live stores whose last sync is over an hour old. The alert fires at 5 during business hours.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM sync_cursors c JOIN stores s ON s.id = c.store_id\nWHERE s.status = 'live' AND c.last_synced_at < now() - interval '1 hour'"
        }
      ],
      "fieldConfig": {
        "defaults": {
