          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, c.store_id, c.device_id, c.last_synced_at, now() - c.last_synced_at AS behind\nFROM sync_cursors c JOIN stores s ON s.id = c.store_id\nORDER BY c.last_synced_at LIMIT 20"
