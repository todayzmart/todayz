    {
      "type": "stat",
      "title": "9 · Read latency budget left (95 % < 200 ms)",
      "description": "Share of the 30-day budget left for GETs slower than 200 ms (target 95 % under).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - (1 - histogram_fraction(0, 0.2, sum(increase(tz_http_server_duration_seconds{method=\"GET\"}[30d])))) / 0.05",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
