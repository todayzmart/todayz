    {
      "type": "table",
      "title": "1 · Slowest endpoints by impact",
      "description": "Impact = RPS × max(0, p95 − budget) over the last hour; budget 200 ms for GET, 400 ms for writes. Row click opens 02 filtered to the route (exemplars there lead to Tempo).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc((sum by (route, method) (rate(tz_http_server_requests_total{method=\"GET\"}[1h])) * clamp_min(histogram_quantile(0.95, sum by (route, method) (rate(tz_http_server_duration_seconds{method=\"GET\"}[1h]))) - 0.2, 0)) or (sum by (route, method) (rate(tz_http_server_requests_total{method!=\"GET\"}[1h])) * clamp_min(histogram_quantile(0.95, sum by (route, method) (rate(tz_http_server_duration_seconds{method!=\"GET\"}[1h]))) - 0.4, 0)))",
          "legendFormat": "impact",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (route, method) (rate(tz_http_server_requests_total[1h]))",
          "legendFormat": "rps",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (route, method) (rate(tz_http_server_duration_seconds[1h])))",
          "legendFormat": "p50",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (route, method) (rate(tz_http_server_duration_seconds[1h])))",
          "legendFormat": "p95",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (route, method) (rate(tz_http_server_duration_seconds[1h])))",
          "legendFormat": "p99",
          "range": false,
          "instant": true,
          "format": "table"
