    {
      "type": "table",
      "title": "5 · Biggest funnel leak today vs 7-day baseline",
      "description": "Each leak's rate today against the previous 7 days (rollup_daily_platform; today is partial, recomputed every 5 min). Δ lost = (today − baseline) × today's base. Checkout quote failures need the checkout_quote_failed event (TODO(lead): not catalogued yet).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH t AS (SELECT * FROM rollup_daily_platform WHERE date = (now() AT TIME ZONE 'Asia/Kolkata')::date),\nb AS (SELECT sum(orders_placed) AS placed, sum(orders_rejected) AS rejected, sum(orders_expired_unaccepted) AS expired_unaccepted,\n             sum(orders_no_show) AS no_show, sum(orders_cancelled) AS cancelled, sum(orders_delivery_failed) AS delivery_failed,\n             sum(searches) AS searches, sum(searches_zero) AS searches_zero\n      FROM rollup_daily_platform WHERE date BETWEEN (now() AT TIME ZONE 'Asia/Kolkata')::date - 7 AND (now() AT TIME ZONE 'Asia/Kolkata')::date - 1),\nleaks AS (\n  SELECT 'Search zero-result' AS leak, t.searches_zero::numeric / nullif(t.searches, 0) AS today, b.searches_zero::numeric / nullif(b.searches, 0) AS baseline, t.searches AS base_today FROM t, b\n  UNION ALL SELECT 'Rejected', t.orders_rejected::numeric / nullif(t.orders_placed, 0), b.rejected::numeric / nullif(b.placed, 0), t.orders_placed FROM t, b\n  UNION ALL SELECT 'Expired unaccepted', t.orders_expired_unaccepted::numeric / nullif(t.orders_placed, 0), b.expired_unaccepted::numeric / nullif(b.placed, 0), t.orders_placed FROM t, b\n  UNION ALL SELECT 'No-show', t.orders_no_show::numeric / nullif(t.orders_placed, 0), b.no_show::numeric / nullif(b.placed, 0), t.orders_placed FROM t, b\n  UNION ALL SELECT 'Cancelled', t.orders_cancelled::numeric / nullif(t.orders_placed, 0), b.cancelled::numeric / nullif(b.placed, 0), t.orders_placed FROM t, b\n  UNION ALL SELECT 'Delivery failed', t.orders_delivery_failed::numeric / nullif(t.orders_placed, 0), b.delivery_failed::numeric / nullif(b.placed, 0), t.orders_placed FROM t, b)\nSELECT leak, round(100 * today, 1) AS today_pct, round(100 * baseline, 1) AS baseline_pct,\n       round((coalesce(today, 0) - coalesce(baseline, 0)) * base_today, 1) AS delta_lost\nFROM leaks ORDER BY delta_lost DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "6 · Stores hurting customers today",
      "description": "Top 10 stores by expired-unaccepted orders plus rejections today, with their average time to accept. Row click opens the store in the admin console.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS store, r.store_id, r.expired_unaccepted, r.rejected, r.orders,\n       r.avg_accept_seconds AS avg_accept_s\nFROM rollup_daily_store r JOIN stores s ON s.id = r.store_id\nWHERE r.date = (now() AT TIME ZONE 'Asia/Kolkata')::date AND r.expired_unaccepted + r.rejected > 0\nORDER BY r.expired_unaccepted + r.rejected DESC, r.orders DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "links": [
            {
              "title": "Open the store in admin",
              "url": "https://admin.todayz.localhost/stores/${__data.fields.store_id}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "7 · Zero-result searches nearby (today)",
      "description": "Queries that found nothing in radius today, with at least 10 such searches (the k ≥ 10 floor, 01 §16). Searches carry an H3 cell, not a city, so this is platform-wide (TODO(lead): per-city split once cells map to cities).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT query_norm AS query, sum(zero_results) AS zero_results, count(DISTINCT geo_cell) AS cells\nFROM rollup_daily_search_demand WHERE date = (now() AT TIME ZONE 'Asia/Kolkata')::date\nGROUP BY query_norm HAVING sum(zero_results) >= 10\nORDER BY zero_results DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "8 · Jobs failing (24 h)",
      "description": "Job kinds with failed, discarded or missed runs in the last 24 h. Row click opens 15 · Jobs filtered to the kind.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT kind, count(*) FILTER (WHERE status IN ('failed', 'discarded')) AS failed,\n       count(*) FILTER (WHERE status = 'missed') AS missed, max(created_at) AS last_run\nFROM job_runs WHERE created_at > now() - interval '24 hours'\nGROUP BY kind HAVING count(*) FILTER (WHERE status IN ('failed', 'discarded', 'missed')) > 0\nORDER BY failed DESC, missed DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "links": [
            {
              "title": "15 · Jobs for this kind",
              "url": "/d/tz-jobs?var-kind=${__data.fields.kind}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "8 · Notification channels failing (> 2 %, 24 h)",
      "description": "Channels and providers whose failure rate is over 2 % in the last 24 h (notification_deliveries).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT channel, provider, count(*) AS sent, count(*) FILTER (WHERE status = 'failed') AS failed,\n       round(100.0 * count(*) FILTER (WHERE status = 'failed') / count(*), 1) AS failed_pct\nFROM notification_deliveries WHERE created_at > now() - interval '24 hours'\nGROUP BY channel, provider HAVING count(*) FILTER (WHERE status = 'failed') * 50 > count(*)\nORDER BY failed_pct DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "9 · Availability budget left (30 d, 99.5 %)",
      "description": "Share of the 30-day error budget still unspent: 1 − (5xx ratio ÷ 0.5 %). 429s are excluded (05 §6). Below 0 the SLO is broken.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - (sum(increase(tz_http_server_requests_total{status_class=\"5xx\"}[30d])) / sum(increase(tz_http_server_requests_total{code!=\"429\"}[30d]))) / 0.005",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
