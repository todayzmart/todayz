    {
      "type": "table",
      "title": "3 · Slowest SQL by total time",
      "description": "Top 10 statements by calls × mean (pg_stat_statements, when the extension is enabled). The sqlc query name is in the comment at the start of each statement.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT left(query, 120) AS query, calls, round(mean_exec_time::numeric, 2) AS mean_ms,\n  round(total_exec_time::numeric, 0) AS total_ms, rows,\n  round(100.0 * shared_blks_hit / nullif(shared_blks_hit + shared_blks_read, 0), 1) AS cache_hit_pct\nFROM pg_stat_statements ORDER BY total_exec_time DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "4 · Worst client screens (p75 LCP above 2.5 s)",
      "description": "Route × app whose p75 LCP is over the 2.5 s budget, sorted by page views × excess. Page views stand in for sessions (RUM has no session counter).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc((histogram_quantile(0.75, sum by (app, route) (rate(tz_rum_lcp_seconds[24h]))) - 2.5 > 0) * histogram_count(sum by (app, route) (increase(tz_rum_lcp_seconds[24h]))))",
          "legendFormat": "views × excess s",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (app, route) (rate(tz_rum_lcp_seconds[24h])))",
          "legendFormat": "p75 LCP",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum by (app, route) (rate(tz_rum_inp_seconds[24h])))",
          "legendFormat": "p75 INP",
