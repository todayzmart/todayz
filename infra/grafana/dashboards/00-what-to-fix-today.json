          "editorMode": "code",
          "expr": "sum by (route, method) (rate(tz_http_server_requests_total{status_class=\"5xx\"}[1h])) / sum by (route, method) (rate(tz_http_server_requests_total[1h]))",
          "legendFormat": "error ratio",
