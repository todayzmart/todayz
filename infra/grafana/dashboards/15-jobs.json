    {
      "id": 13,
      "type": "timeseries",
      "title": "Attempts and retries",
      "description": "job_runs rows per hour: first attempts and retries (attempt > 1).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), count(*) FILTER (WHERE attempt = 1) AS first_attempts,\n  count(*) FILTER (WHERE attempt > 1) AS retries\nFROM job_runs WHERE $__timeFilter(created_at) AND kind IN ($kind) AND status <> 'missed'\nGROUP BY 1 ORDER BY 1"
        }
