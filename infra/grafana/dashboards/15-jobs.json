    {
      "id": 2,
      "type": "stat",
      "title": "Kinds failing now",
      "description": "Kinds whose latest finished run (succeeded, failed, discarded or cancelled) failed or was discarded. A-21 shows them with the Failing badge.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM (\n  SELECT DISTINCT ON (kind) kind, status FROM job_runs\n  WHERE status IN ('succeeded', 'failed', 'discarded', 'cancelled') AND created_at > now() - interval '30 days'\n  ORDER BY kind, created_at DESC, id DESC) last\nWHERE status IN ('failed', 'discarded')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
