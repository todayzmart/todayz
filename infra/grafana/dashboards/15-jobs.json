    {
      "id": 8,
      "type": "table",
      "title": "Every kind (7 days)",
      "description": "Last run, 7-day success rate (succeeded / (succeeded + failed + cancelled + discarded); skipped and yielded excluded), average and maximum duration, pause state. Owner, schedule and next run come from the registry: see A-21. Click a kind for its run history below.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (kind) kind, class, status, trigger, created_at FROM job_runs\n  WHERE status <> 'missed' AND created_at > now() - interval '30 days'\n  ORDER BY kind, created_at DESC, id DESC),\nst AS (\n  SELECT kind, sum(succeeded) AS s, sum(failed) AS f, sum(cancelled) AS c, sum(discarded) AS d,\n    sum(skipped) AS sk, sum(yielded) AS y, sum(sum_ms) AS ms, max(max_ms) AS mx\n  FROM job_stats_hourly WHERE hour >= now() - interval '7 days' GROUP BY kind),\nmissed AS (\n  SELECT kind, max(created_at) AS at FROM job_runs WHERE status = 'missed' AND created_at > now() - interval '7 days' GROUP BY kind)\nSELECT coalesce(l.kind, st.kind) AS kind, l.class, l.status AS last_status, l.trigger AS last_trigger, l.created_at AS last_run,\n  m.at AS last_missed,\n  round(100.0 * st.s / nullif(st.s + st.f + st.c + st.d, 0), 1) AS success_7d_pct,\n  (st.s + st.f + st.c + st.d + st.sk + st.y) AS runs_7d,\n  round(st.ms::numeric / nullif(st.s + st.f + st.c + st.d + st.sk + st.y, 0)) AS avg_ms, st.mx AS max_ms,\n  coalesce(jc.paused, false) AS paused, jc.reason AS pause_reason\nFROM last l\nFULL JOIN st ON st.kind = l.kind\nLEFT JOIN missed m ON m.kind = coalesce(l.kind, st.kind)\nLEFT JOIN job_controls jc ON jc.kind = coalesce(l.kind, st.kind)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "kind"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Run history",
                    "url": "/d/tz-jobs/15-jobs?${__url_time_range}&var-kind=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success_7d_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 95
                    },
                    {
                      "color": "green",
                      "value": 99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "discarded": {
                        "color": "red",
                        "index": 2
                      },
                      "cancelled": {
                        "color": "orange",
                        "index": 3
                      },
                      "running": {
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "avg_ms|max_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "kind",
            "desc": false
          }
        ]
      }
    },
