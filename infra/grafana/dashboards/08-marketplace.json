            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM o.collected_at - o.accepted_at) / 60) AS value\nFROM orders o WHERE o.status = 'collected' AND $__timeFilter(o.placed_at) AND o.store_id IN (SELECT s.id FROM stores s WHERE ('${city}' = '__all' OR s.city = '${city}'))"
