    {
      "type": "stat",
      "title": "Code failures (wrong pickup codes)",
      "description": "Wrong pickup-code attempts on orders in range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
