    {
      "type": "timeseries",
      "title": "Orders placed per hour",
      "description": "Every order placed, any outcome.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.placed_at, '1h'), count(*) AS placed FROM v_metric_orders o\nWHERE $__timeFilter(o.placed_at) AND o.store_id IN (SELECT s.id FROM stores s WHERE ('${city}' = '__all' OR s.city = '${city}')) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
