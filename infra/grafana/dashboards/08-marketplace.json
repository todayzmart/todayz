            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(o.code_attempts), 0) AS value FROM orders o WHERE $__timeFilter(o.placed_at) AND o.store_id IN (SELECT s.id FROM stores s WHERE ('${city}' = '__all' OR s.city = '${city}'))"
        }
      ],
