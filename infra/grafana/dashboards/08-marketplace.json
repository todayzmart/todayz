    {
      "type": "table",
      "title": "Under-supplied cells: zero-result searches per cell (7 d)",
      "description": "H3 resolution-8 cells with at least 10 searches (k floor), worst zero-result count first. The map with live stores per cell is on Pulse (A-02); the database has no H3 functions, so the store side is computed in Go there.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_hex(geo_cell) AS cell, sum(searches) AS searches, sum(zero_results) AS zero_results,\n       round(100.0 * sum(zero_results) / nullif(sum(searches), 0)) AS zero_pct\nFROM rollup_daily_search_demand WHERE date > (now() AT TIME ZONE 'Asia/Kolkata')::date - 7 AND geo_cell IS NOT NULL\nGROUP BY geo_cell HAVING sum(searches) >= 10 ORDER BY zero_results DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 27,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 9
      }
