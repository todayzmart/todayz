    {
      "type": "bargauge",
      "title": "Time to accept",
      "description": "Placed → accepted for accepted orders.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN accept_seconds < 60 THEN '< 1 min' WHEN accept_seconds < 180 THEN '1–3 min' WHEN accept_seconds < 300 THEN '3–5 min'\n            WHEN accept_seconds < 600 THEN '5–10 min' ELSE '10 min +' END AS bucket, count(*) AS orders, min(accept_seconds) AS o\nFROM v_metric_orders o WHERE accepted AND $__timeFilter(o.placed_at) AND o.store_id IN (SELECT s.id FROM stores s WHERE ('${city}' = '__all' OR s.city = '${city}')) GROUP BY 1 ORDER BY o"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "o": true
            }
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Accept → collect p50 (min)",
      "description": "Median minutes from acceptance to collection (pickup).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
