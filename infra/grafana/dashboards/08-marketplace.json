    {
      "type": "timeseries",
      "title": "Order outcome breakdown",
      "description": "Every order by its outcome and reason (D-60, D-68), 100 % stacked per day. Expired reasons: not_accepted, no_show, dispatch_timeout; partial timeout is cancelled: partial_timeout.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(o.placed_at, '1d'),\n  CASE WHEN o.status = 'cancelled' THEN 'cancelled: ' || coalesce(o.status_reason, 'unknown')\n       WHEN o.status = 'rejected' THEN 'rejected: ' || coalesce(o.status_reason, 'unknown')\n       WHEN o.status = 'expired' THEN 'expired: ' || coalesce(o.status_reason, 'unknown')\n       WHEN o.status = 'delivery_failed' THEN 'delivery failed: ' || coalesce(o.status_reason, 'unknown')\n       ELSE o.status END AS metric,\n  count(*) AS value\nFROM v_metric_orders o WHERE $__timeFilter(o.placed_at) AND o.store_id IN (SELECT s.id FROM stores s WHERE ('${city}' = '__all' OR s.city = '${city}')) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "percent"
            },
            "fillOpacity": 60,
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Leak rates per day",
      "description": "Each leak as a share of orders placed that day (rollup_daily_platform).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (date::timestamp AT TIME ZONE 'Asia/Kolkata') AS time,\n  orders_rejected::float / nullif(orders_placed, 0) AS rejected,\n  orders_expired_unaccepted::float / nullif(orders_placed, 0) AS expired_unaccepted,\n  orders_no_show::float / nullif(orders_placed, 0) AS no_show,\n  orders_cancelled::float / nullif(orders_placed, 0) AS cancelled,\n  orders_delivery_failed::float / nullif(orders_placed, 0) AS delivery_failed\nFROM rollup_daily_platform WHERE $__timeFilter(date) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
