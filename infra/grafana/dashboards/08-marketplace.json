    {
      "type": "timeseries",
      "title": "GMV per day (₹)",
      "description": "Online GMV, linked POS GMV and unlinked POS sales (shown separately, never added to GMV). Platform-wide.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "todayz-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "todayz-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (date::timestamp AT TIME ZONE 'Asia/Kolkata') AS time, gmv_paise / 100.0 AS online, pos_gmv_paise / 100.0 AS pos_linked, pos_unlinked_paise / 100.0 AS shop_sales_recorded\nFROM rollup_daily_platform WHERE $__timeFilter(date) ORDER BY 1"
        }
