{
  "uid": "todayz-02",
  "title": "02 API endpoints",
  "description": "RED by route template.",
  "tags": [
    "todayz"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(tz_http_server_requests_total, route)",
          "refId": "route"
        },
        "definition": "label_values(tz_http_server_requests_total, route)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "What to fix today",
      "url": "/d/todayz-00",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this",
      "datasource": null,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A"
        }
      ],
      "options": {
        "mode": "markdown",
        "content": "Pick a route to see its latency distribution, error codes and warn+ logs. The table below ranks every route; click through from the worst one. Route labels are templates (`/v1/orders/{id}`), never raw paths."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "All routes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (route, method) (rate(tz_http_server_requests_total{route=~\"$route\"}[$__range]))",
          "legendFormat": "rps"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (route, method) (rate(tz_http_server_requests_total{route=~\"$route\",status_class=\"5xx\"}[$__range])) / sum by (route, method) (rate(tz_http_server_requests_total{route=~\"$route\"}[$__range]))",
          "legendFormat": "error ratio"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.5, sum by (route, method) (rate(tz_http_server_duration_seconds{route=~\"$route\"}[$__range])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (route, method) (rate(tz_http_server_duration_seconds{route=~\"$route\"}[$__range])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.99, sum by (route, method) (rate(tz_http_server_duration_seconds{route=~\"$route\"}[$__range])))",
          "legendFormat": "p99"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RPS by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(tz_http_server_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (route) (rate(tz_http_server_duration_seconds{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Latency distribution (selected routes)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(tz_http_server_duration_seconds{route=~\"$route\"}[$__rate_interval]))",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error codes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(tz_http_server_requests_total{route=~\"$route\",code!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Status class by app",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app, status_class) (rate(tz_http_server_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Status class by method",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, status_class) (rate(tz_http_server_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Warn and error logs for the route",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"todayz-api\"} | json | level=~\"warn|error\" | route=~\"$route\""
        }
      ]
    }
  ]
}
