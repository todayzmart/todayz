{
  "name": "@todayz/customer",
  "version": "0.0.0",
  "private": true,
  "description": "TodayZ customer PWA (app.todayz.in).",
  "type": "module",
  "scripts": {
    "gen": "tsr generate",
    "dev": "vite",
    "build": "tsr generate && tsc --noEmit -p tsconfig.json && vite build && node node_modules/@todayz/auth/scripts/precache-check.mjs && node node_modules/@todayz/config/dist-check.mjs dist",
    "build:e2e": "tsr generate && vite build --mode e2e && node node_modules/@todayz/auth/scripts/precache-check.mjs && node node_modules/@todayz/config/dist-check.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --max-warnings 0 \"src/**/*.css\"",
    "test": "vitest run",
    "size": "size-limit",
    "e2e:smoke": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@todayz/api-client": "workspace:*",
    "@todayz/auth": "workspace:*",
    "@todayz/i18n": "workspace:*",
    "@todayz/realtime": "workspace:*",
    "@todayz/telemetry": "workspace:*",
    "@todayz/tokens": "workspace:*",
    "@todayz/ui": "workspace:*",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@size-limit/file": "12.1.0",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@todayz/config": "workspace:*",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "happy-dom": "20.14.5",
    "size-limit": "12.1.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
