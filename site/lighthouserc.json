{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/hi/index.html",
        "/kn/index.html",
        "/te/index.html",
        "/ta/index.html",
        "/for-retailers/index.html",
        "/pricing/index.html",
        "/contact/index.html",
        "/legal/privacy/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "blockedUrlPatterns": [
          "*challenges.cloudflare.com*"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/mobile"
    }
  }
}
