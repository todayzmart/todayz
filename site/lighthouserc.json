{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/hi/index.html",
        "/kn/index.html",
        "/te/index.html",
        "/ta/index.html",
        "/for-retailers/index.html",
        "/pricing/index.html",
        "/contact/index.html",
        "/legal/privacy/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "blockedUrlPatterns": [
          "*challenges.cloudflare.com*"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
