---
// Placeholder home. The site WP replaces the body; the frame, tokens and copy pipeline stay.
import Base from '../layouts/Base.astro';
import { t } from '../lib/messages';
---

<Base title={t('site.title')} description={t('site.description')}>
  <header class="tz-hero-wash hero">
    <div class="column">
      <span class="tz-side-brand brand">
        <img class="mark" src="/icons/mark-96.png" alt="" width="32" height="32" />
        <span>Today<b>Z</b></span>
      </span>
      <h1 class="title">{t('site.hero.title')}</h1>
      <p class="sub">{t('site.hero.sub')}</p>
    </div>
  </header>
  <div class="column body">
    <section class="tz-card soon" aria-labelledby="soon-title">
      <span class="tz-tag">{t('site.soon.tag')}</span>
      <h2 id="soon-title" class="tz-card-title">{t('site.soon.title')}</h2>
      <p class="tz-card-desc">{t('site.soon.body')}</p>
    </section>
  </div>
</Base>

<style>
  .column {
    max-width: 720px;
    margin: 0 auto;
    padding-inline: var(--space-4);
  }

  .hero {
    padding-block: var(--space-6) var(--space-10);
  }

  .hero .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .brand {
    margin: 0;
    padding: 0;
    gap: var(--space-2);
  }

  .mark {
    width: 32px;
    height: 32px;
  }

  .title {
    margin: 0;
    font: var(--type-display);
    letter-spacing: var(--type-display-tracking);
    color: var(--ink);
  }

  .sub {
    margin: 0;
    max-width: 56ch;
    font: var(--type-body);
    color: var(--ink-2);
  }

  .body {
    padding-block: var(--space-6);
  }

  .soon {
    align-items: flex-start;
  }
</style>
