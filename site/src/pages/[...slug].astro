---
// Every page in every locale comes from the registry (src/lib/pages.ts).
import type { GetStaticPaths } from 'astro';
import { allRoutes, pagePath, viewOf } from '../lib/pages.ts';
import { SITE_LOCALES } from '../lib/site-locales.ts';
import HomeView from '../views/HomeView.astro';
import InfoView from '../views/InfoView.astro';
import LegalView from '../views/LegalView.astro';
import RetailersView from '../views/RetailersView.astro';

export const getStaticPaths = (() =>
  allRoutes(SITE_LOCALES).map(({ page, locale }) => {
    const path = pagePath(page, locale).replace(/^\/|\/$/g, '');
    return { params: { slug: path === '' ? undefined : path }, props: { page, locale } };
  })) satisfies GetStaticPaths;

const { page, locale } = Astro.props;
const view = viewOf(page.id);
---

{view === 'home' && <HomeView locale={locale} />}
{view === 'retailers' && <RetailersView locale={locale} />}
{view === 'info' && <InfoView page={page} locale={locale} />}
{view === 'legal' && <LegalView page={page} locale={locale} />}
