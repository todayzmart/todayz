---
// Page frame for every route: real HTML, tokens and fonts from @todayz/tokens, SEO tags (canonical,
// hreflang, Open Graph, Twitter, JSON-LD) and no client JS except the lead form's own bundle and the
// Turnstile script on pages that hold the form.
import '@todayz/tokens/styles.css';
import '../styles/silver.css';
import head from 'virtual:todayz-head';
import manropeLatin from '../assets/fonts/manrope-variable.woff2?url';
import soraLatin from '../assets/fonts/sora-variable.woff2?url';
import anekDevanagari from '@todayz/tokens/fonts/anek-devanagari-devanagari-wght-normal.woff2?url';
import anekKannada from '@todayz/tokens/fonts/anek-kannada-kannada-wght-normal.woff2?url';
import anekTelugu from '@todayz/tokens/fonts/anek-telugu-telugu-wght-normal.woff2?url';
import anekTamil from '@todayz/tokens/fonts/anek-tamil-tamil-wght-normal.woff2?url';
import notoDevanagari from '@todayz/tokens/fonts/noto-sans-devanagari-devanagari-wght-normal.woff2?url';
import notoKannada from '@todayz/tokens/fonts/noto-sans-kannada-kannada-wght-normal.woff2?url';
import notoTelugu from '@todayz/tokens/fonts/noto-sans-telugu-telugu-wght-normal.woff2?url';
import notoTamil from '@todayz/tokens/fonts/noto-sans-tamil-tamil-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/premium-frame.css';
import '../styles/brand-accents.css';
import '../styles/experience.css';
import '../styles/refinements.css';
import themeInit from '../scripts/theme-init.js?url';
import { LOCALE_INFO, createT, isMachineDraft, type Locale } from '../i18n/index.ts';
import { alternates, pagePath, pageUrl, SITE_ORIGIN, type PageDef } from '../lib/pages.ts';
import { SITE_LOCALES } from '../lib/site-locales.ts';

interface Props {
  page: PageDef;
  locale: Locale;
  /** Structured data objects, written as one JSON-LD script each. */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}

const { page, locale, jsonLd = [], noindex = false } = Astro.props;
const t = createT(locale);
const info = LOCALE_INFO[locale];
const title = `${t(page.title)}${t(page.title).includes('TodayZ') ? '' : ' | TodayZ'}`;
const description = t(page.description);
const canonical = pageUrl(page, locale);
const ogImage = `${SITE_ORIGIN}/og/${page.id}${locale === 'en' ? '' : `-${locale}`}.png`;
const draft = isMachineDraft(locale);
// The 404 and machine drafts stay out of search results. A noindex page names no canonical, hreflang
// or og:url: it is not the address of anything (the 404 is served at every unknown path).
const robotsNoindex = noindex || draft;
const hreflang = noindex ? [] : alternates(page, SITE_LOCALES);
const englishPath = pagePath(page, 'en');
// Preload the faces the first screen draws, so text does not reflow when they swap in (Lighthouse
// CLS on the localised heroes): Latin display and body on every page (Indic headings still use Anek
// Latin for punctuation and digits, and the mock screens are English), plus the page script's display
// and body faces. Same files as @todayz/tokens' @font-face rules, so the browser reuses the response.
const LATIN = [manropeLatin, soraLatin];
const SCRIPT_FONTS: Record<Locale, string[]> = {
  en: [],
  hi: [anekDevanagari, notoDevanagari],
  kn: [anekKannada, notoKannada],
  te: [anekTelugu, notoTelugu],
  ta: [anekTamil, notoTamil],
};
const preloads = [...LATIN, ...SCRIPT_FONTS[locale]];
---

<!doctype html>
<html lang={info.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <script is:inline src={themeInit}></script>
    <title>{title}</title>
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {hreflang.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {draft && <meta name="todayz:translation" content="machine-draft" />}
    <meta property="og:site_name" content="TodayZ" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={info.og} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {head.map(({ tag, attrs }) => (tag === 'link' ? <link {...attrs} /> : <meta {...attrs} />))}
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
    {page.leadForm && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
  </head>
  <body data-skin="bright">
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <Header page={page} locale={locale} />
    {
      draft && (
        <p class="draft" role="note">
          {t('draft.notice')} <a href={englishPath} hreflang="en">{t('draft.switch')}</a>
        </p>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>import '../scripts/presentation.ts';</script>
  </body>
</html>

<style is:global>
  /* The sticky header must never cover a focused element or an anchor target (WCAG 2.4.11). */
  html {
    scroll-padding-top: 84px;
  }

  /* Indic scripts stack vowel signs above and below the line (design/source/localization.md), so
     the tight display line heights of the landing would clip them: restore the bundle's 1.6 for
     text and use 1.45 for headings, and never track Indic text. !important because the landing's
     section rules are more specific. Example screens (aria-hidden) keep their compact layout. */
  html:is(:lang(hi), :lang(kn), :lang(te), :lang(ta)) :is(p, a, li, span, summary, label, button, input, small, b):not([aria-hidden='true'] *) {
    line-height: 1.6 !important;
    letter-spacing: 0 !important;
  }

  html:is(:lang(hi), :lang(kn), :lang(te), :lang(ta)) :is(h1, h2, h3) {
    line-height: 1.45 !important;
    letter-spacing: 0 !important;
  }
</style>

<style>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    margin: 0;
    background: var(--page);
    color: var(--ink);
  }

  main {
    flex: 1;
    outline: none;
  }

  .skip {
    position: absolute;
    left: var(--space-3);
    top: calc(-1 * var(--space-12));
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--inverse);
    color: var(--on-inverse);
    text-decoration: none;
  }

  .skip:focus {
    top: var(--space-3);
  }

  .draft {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--warning-soft);
    color: var(--ink);
    font: var(--type-body-sm);
    text-align: center;
  }

  .draft a {
    color: var(--ink);
    font-weight: 600;
  }
</style>
