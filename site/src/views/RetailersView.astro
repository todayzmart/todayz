---
// S-02 For retailers, in any language. The landing components with the shop-facing sections only;
// the hero carries the retailers copy, everything else reuses the home text.
import Bento from '../components/home/Bento.astro';
import Cta from '../components/home/Cta.astro';
import DemandInsights from '../components/home/DemandInsights.astro';
import FaqSection from '../components/home/FaqSection.astro';
import HeroScene from '../components/home/HeroScene.astro';
import Marquee from '../components/home/Marquee.astro';
import ShopTypes from '../components/home/ShopTypes.astro';
import Showcase from '../components/home/Showcase.astro';
import ThreeSteps from '../components/home/ThreeSteps.astro';
import { EM } from '../components/home/data.ts';
import Base from '../layouts/Base.astro';
import { createT, type Locale, type MessageKey } from '../i18n/index.ts';
import { faqJsonLd, softwareApplicationJsonLd } from '../lib/jsonld.ts';
import { pageById } from '../lib/pages.ts';
import '../styles/landing.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = pageById('retailers');
const t = createT(locale);
const faq = [1, 2, 3].map((i) => ({ q: t(`retailers.faq.${i}.q` as MessageKey), a: t(`retailers.faq.${i}.a` as MessageKey) }));
---

<Base page={page} locale={locale} jsonLd={[softwareApplicationJsonLd(locale, t('retailers.meta.description')), faqJsonLd(faq)]}>
  <div class="lp">
    <HeroScene
      t={t}
      kicker={t('nav.retailers')}
      title={t('retailers.hero.title', EM)}
      titleEm={t('retailers.hero.title_em')}
      body={t('retailers.hero.body')}
      primaryHref="#join"
      secondaryHref="#how"
    />
    <Marquee t={t} />
    <Bento t={t} />
    <Showcase t={t} />
    <DemandInsights t={t} />
    <ThreeSteps t={t} />
    <ShopTypes t={t} />
    <FaqSection t={t} title={t('retailers.faq.title')} items={faq} />
    <Cta t={t} locale={locale} source="retailers" />
  </div>
</Base>
