---
// S-03 How it works, Pricing, About and Contact (English only), under the bright page head (D-262).
import PageHead from '../components/bright/PageHead.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Section from '../components/Section.astro';
import Steps from '../components/Steps.astro';
import Base from '../layouts/Base.astro';
import { createT, type Locale, type MessageKey } from '../i18n/index.ts';
import { company, links } from '../lib/company.ts';
import { softwareApplicationJsonLd } from '../lib/jsonld.ts';
import { pageById, pagePath, type PageDef } from '../lib/pages.ts';
import '../styles/bright.css';

interface Props {
  page: PageDef;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = createT(locale);
const key = (k: string) => k as MessageKey;
const kind = page.id;
const ns = `info.${kind}`;
const shopSteps = [1, 2, 3].map((i) => ({ title: t(key(`home.steps.${i}.title`)), body: t(key(`home.steps.${i}.body`)) }));
const shopperSteps = [1, 2, 3, 4].map((i) => ({ title: t(key(`home.shoppers.${i}`)) }));
const points = [1, 2, 3].map((i) => t(key(`info.pricing.point.${i}`)));
const paragraphs = [1, 2, 3].map((i) => t(key(`info.about.${i}`)));
const retailersHref = pagePath(pageById('retailers'), locale);
const joinHref = `${pagePath(pageById('contact'), locale)}#join`;
const jsonLd = kind === 'pricing' ? [softwareApplicationJsonLd(locale, t('info.pricing.meta.description'))] : [];
---

<Base page={page} locale={locale} jsonLd={jsonLd}>
  <div class="bp">
    <PageHead title={t(key(`${ns}.title`))} body={kind !== 'about' ? t(key(`${ns}.intro`)) : undefined} />
  </div>

  {
    kind === 'how' && (
      <>
        <Section id="shops" title={t('info.how.shops.title')}>
          <Steps items={shopSteps} columns={3} />
          <p><a class="tz-btn tz-btn-brand" href={retailersHref}>{t('nav.retailers')} <Icon name="arrow" size={18} /></a></p>
        </Section>
        <Section tone="wash" id="shoppers" title={t('info.how.shoppers.title')}>
          <Steps items={shopperSteps} columns={4} />
          <p><a class="tz-btn tz-btn-primary" href={links.customerApp}>{t('home.shoppers.cta')} <Icon name="arrow" size={18} /></a></p>
        </Section>
      </>
    )
  }

  {
    kind === 'pricing' && (
      <Section id="plan">
        <ul class="points">
          {points.map((p) => (
            <li class="tz-card"><span class="tick"><Icon name="check" size={18} /></span><p>{p}</p></li>
          ))}
        </ul>
        <p><a class="tz-btn tz-btn-brand tz-btn-lg" href={joinHref}>{t('nav.cta')}</a></p>
      </Section>
    )
  }

  {
    kind === 'about' && (
      <Section id="story">
        <div class="prose">{paragraphs.map((p) => <p>{p}</p>)}</div>
      </Section>
    )
  }

  {
    kind === 'contact' && (
      <>
        {company.email && (
          <Section id="email">
            <p class="prose"><b>{t('info.contact.email')}:</b> <a href={`mailto:${company.email}`}>{company.email}</a></p>
          </Section>
        )}
        <Section tone="wash" id="join">
          <LeadForm locale={locale} source="contact" />
        </Section>
      </>
    )
  }
</Base>

<style>
  .points {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    max-width: 760px;
  }

  .points li {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .points p {
    margin: 0;
    font: var(--type-body);
    color: var(--ink-2);
  }

  .tick {
    color: var(--brand-strong);
    flex: none;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 68ch;
    font: var(--type-body-lg);
    color: var(--ink-2);
  }

  .prose p {
    margin: 0;
  }
</style>
