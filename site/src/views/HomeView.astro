---
// S-01 Home, in any language: the bright landing (D-262, components/bright, styles/bright.css), ported
// from design/trials/site-home-bright. The FAQ and the lead form (#join) keep the landing styles (.lp).
import Cost from '../components/premium/Cost.astro';
import DiscoveryPreview from '../components/premium/DiscoveryPreview.astro';
import Journey from '../components/premium/Journey.astro';
import Orbit from '../components/premium/Orbit.astro';
import Owners from '../components/premium/Owners.astro';
import PhotoCredits from '../components/bright/PhotoCredits.astro';
import Savings from '../components/premium/Savings.astro';
import SearchStrip from '../components/premium/SearchStrip.astro';
import Shelf from '../components/premium/Shelf.astro';
import Week from '../components/premium/Week.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';

import { EM, splitEm } from '../components/home/data.ts';
import { createT, type Locale, type MessageKey } from '../i18n/index.ts';
import { company, links } from '../lib/company.ts';
import { faqJsonLd, organizationJsonLd, websiteJsonLd } from '../lib/jsonld.ts';
import { pageById } from '../lib/pages.ts';
import Base from '../layouts/Base.astro';

import '../styles/premium.css';


interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = pageById('home');
const t = createT(locale);
const faq = [1, 2, 3, 4].map((i) => ({ q: t(`home.faq.${i}.q` as MessageKey), a: t(`home.faq.${i}.a` as MessageKey) }));
const [headlineBefore, headlineAfter] = splitEm(t('home.lede.title', EM));
const stats = [1, 2, 3].map((i) => ({ value: t(`home.lede.stat.${i}.value` as MessageKey), label: t(`home.lede.stat.${i}.label` as MessageKey) }));
---

<Base page={page} locale={locale} jsonLd={[organizationJsonLd(company), websiteJsonLd(locale), faqJsonLd(faq)]}>
<div class="premium">
  <section class="p-hero" aria-labelledby="home-title">

    <div class="p-hero-copy">
      <p class="p-kicker"><span></span>{t('home.lede.badge')}</p>
      <h1 id="home-title">{headlineBefore}<em>{t('home.lede.title_em')}</em>{headlineAfter}</h1>
      <p class="p-intro">{t('home.lede.body')}</p>
      <form class="p-search" action="/" data-search-target={`${links.customerApp}/search`} method="get" role="search">
        <label class="sr-only" for="home-search">{t('home.lede.search_label')}</label>
        <Icon name="search" size={22}/><input id="home-search" name="q" type="search" placeholder={t('home.lede.search_placeholder')}/>
        <button type="submit" aria-label={t('home.lede.search_go')}><Icon name="arrow" size={22}/></button>
      </form>
      <noscript><a href={`${links.customerApp}/search`}>{t('nav.search')}</a></noscript>
      <div class="p-hero-links"><a href="#shelf">{t('home.shelf.find')} <Icon name="arrow" size={16}/></a><a href="#journey">{t('nav.how')} <Icon name="arrow" size={16}/></a></div>
    </div>
    <DiscoveryPreview t={t} appUrl={links.customerApp}/>
    <div class="p-metrics">{stats.map((s,i)=><div><small>0{i+1}</small><strong>{s.value}</strong><span>{s.label}</span></div>)}</div>
  </section>
  <p class="p-example">{t('home.hero.note')}</p>
  <SearchStrip t={t} appUrl={links.customerApp}/>
  <Shelf t={t} appUrl={links.customerApp}/>
  <Orbit t={t}/>
  <Journey t={t}/>
  <div class="p-benefits"><Cost t={t}/><Week t={t}/></div>
  <Savings t={t} appUrl={links.customerApp}/>
  <Owners t={t} href="#join"/>
  <section class="p-faq p-section" id="faq"><div><p class="p-kicker">{t('home.faq.eyebrow')}</p><h2>{t('home.faq.title')}</h2><p>{t('home.faq.intro')}</p></div><div>{faq.map((f,i)=><details><summary><small>0{i+1}</small>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></section>
  <section class="p-join p-section" id="join"><div><p class="p-kicker">{t('cta.eyebrow')}</p><h2 id="join-title">{t('cta.title')}</h2><p>{t('cta.body')}</p><ul>{[1,2,3].map(i=><li><Icon name="check" size={16}/>{t(`cta.tick.${i}` as MessageKey)}</li>)}</ul></div><LeadForm locale={locale} source="home" id="lead" variant="cta" labelledBy="join-title"/></section>
  <PhotoCredits t={t}/>
</div>
</Base>
<script>
import '../components/bright/bright.ts';
const form=document.querySelector<HTMLFormElement>('[data-search-target]');
form?.addEventListener('submit',event=>{event.preventDefault();const url=new URL(form.dataset['searchTarget']!);const q=new FormData(form).get('q');if(typeof q==='string'&&q.trim())url.searchParams.set('q',q.trim());window.location.assign(url.href);});
document.querySelectorAll<HTMLButtonElement>('[data-shop-choice]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-shop-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-shop-detail]').forEach(card=>card.hidden=card.dataset['shopDetail']!==button.dataset['shopChoice']);}));
</script>
