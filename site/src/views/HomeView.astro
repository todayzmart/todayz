---
// S-01 Home, in any language: the landing page (components/home, styles/landing.css).
import Bento from '../components/home/Bento.astro';
import Cta from '../components/home/Cta.astro';
import DemandInsights from '../components/home/DemandInsights.astro';
import FaqSection from '../components/home/FaqSection.astro';
import HeroScene from '../components/home/HeroScene.astro';
import IdeaBand from '../components/home/IdeaBand.astro';
import Marquee from '../components/home/Marquee.astro';
import Problems from '../components/home/Problems.astro';
import Shoppers from '../components/home/Shoppers.astro';
import ShopTypes from '../components/home/ShopTypes.astro';
import Showcase from '../components/home/Showcase.astro';
import Testimonials from '../components/home/Testimonials.astro';
import ThreeSteps from '../components/home/ThreeSteps.astro';
import { EM } from '../components/home/data.ts';
import { createT, type Locale, type MessageKey } from '../i18n/index.ts';
import { company, links } from '../lib/company.ts';
import { faqJsonLd, organizationJsonLd, websiteJsonLd } from '../lib/jsonld.ts';
import { pageById } from '../lib/pages.ts';
import Base from '../layouts/Base.astro';
import '../styles/landing.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = pageById('home');
const t = createT(locale);
const faq = [1, 2, 3, 4].map((i) => ({ q: t(`home.faq.${i}.q` as MessageKey), a: t(`home.faq.${i}.a` as MessageKey) }));
---

<Base page={page} locale={locale} jsonLd={[organizationJsonLd(company), websiteJsonLd(locale), faqJsonLd(faq)]}>
  <div class="lp">
    <HeroScene
      t={t}
      kicker={t('home.hero.kicker')}
      title={t('home.hero.title', EM)}
      titleEm={t('home.hero.title_em')}
      body={t('home.hero.body')}
      primaryHref="#join"
      secondaryHref="#how"
    />
    <Marquee t={t} />
    <Problems t={t} />
    <IdeaBand t={t} />
    <Bento t={t} />
    <Showcase t={t} />
    <DemandInsights t={t} />
    <Shoppers t={t} appUrl={links.customerApp} />
    <ThreeSteps t={t} />
    <ShopTypes t={t} />
    <Testimonials t={t} />
    <FaqSection t={t} title={t('home.faq.title')} items={faq} />
    <Cta t={t} locale={locale} source="home" />
  </div>
</Base>
