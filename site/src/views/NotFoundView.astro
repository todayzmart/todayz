---
// The 404 page: noindex, plain, one way home, under the bright page head (D-262).
import Icon from '../components/Icon.astro';
import PageHead from '../components/bright/PageHead.astro';
import Base from '../layouts/Base.astro';
import { createT } from '../i18n/index.ts';
import { pageById, type PageDef } from '../lib/pages.ts';
import '../styles/bright.css';

const t = createT('en');
const page: PageDef = { ...pageById('home'), title: 'info.404.meta.title', leadForm: false };
---

<Base page={page} locale="en" noindex>
  <div class="bp">
    <PageHead title={t('info.404.title')} body={t('info.404.body')}>
      <a class="b-btn" href="/">{t('info.404.cta')}<Icon name="arrow" size={16} /></a>
    </PageHead>
  </div>
</Base>
