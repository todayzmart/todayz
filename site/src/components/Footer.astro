---
// Compact green-black glass footer: original artwork, app entry, company, legal and languages.
import { LOCALE_INFO, createT, type Locale } from '../i18n/index.ts';
import logo from '../../../design/source/assets/Logos/todayz-logo.jpg';
import { links } from '../lib/company.ts';
import Icon from './Icon.astro';
import { pageById, pageLocales, pagePath, type PageId } from '../lib/pages.ts';
import { SITE_LOCALES } from '../lib/site-locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
const year = new Date().getFullYear();

/** Link to a page in the current language when it exists in it, otherwise in English. */
function link(id: PageId): { href: string; hreflang: string | undefined } {
  const target = pageById(id);
  const inLocale = pageLocales(target, SITE_LOCALES).includes(locale);
  return { href: pagePath(target, inLocale ? locale : 'en'), hreflang: inLocale ? undefined : 'en' };
}

const company = (['retailers', 'how', 'pricing', 'about', 'contact'] as const).map((id) => ({ ...link(id), label: t(`nav.${id}`) }));
const legal = (
  [
    ['privacy', 'footer.privacy'],
    ['terms-shoppers', 'footer.terms_shoppers'],
    ['terms-shops', 'footer.terms_shops'],
    ['refunds', 'footer.refunds'],
  ] as const
).map(([id, key]) => ({ ...link(id), label: t(key) }));
const home = pageById('home');
const languages = pageLocales(home, SITE_LOCALES).map((l) => ({ locale: l, href: pagePath(home, l), tag: LOCALE_INFO[l].tag, native: LOCALE_INFO[l].native }));
---

<footer class="site-foot">
  <div class="foot-invite">
    <div><p class="foot-eyebrow">{t('home.lede.badge')}</p><h2>{t('footer.tagline')}</h2></div>
    <div class="foot-actions"><a class="foot-primary" href={links.customerApp}>{t('home.shelf.find')}<Icon name="arrow" size={18}/></a><a href={link('retailers').href}>{t('nav.retailers')}<Icon name="arrow" size={18}/></a></div>
  </div>
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="brand" href={link('home').href}><img class="brand-logo" src={logo.src} width="180" height="60" alt="TodayZ" loading="lazy" /></a>
      <p>{t('home.lede.body')}</p>
    </div>
    <nav aria-label={t('footer.company')}>
      <h2>{t('footer.company')}</h2>
      {company.map((item) => <a href={item.href} hreflang={item.hreflang}>{item.label}</a>)}
    </nav>
    <nav aria-label={t('footer.legal')}>
      <h2>{t('footer.legal')}</h2>
      {legal.map((item) => <a href={item.href} hreflang={item.hreflang}>{item.label}</a>)}
    </nav>
  </div>
  <div class="foot-base">
    <p>{t('footer.copy', { year })}</p>
    <ul class="langs" aria-label={t('a11y.language')}>
      {
        languages.map((l) => (
          <li>
            <a href={l.href} lang={l.tag} hreflang={l.locale} aria-current={l.locale === locale ? 'true' : undefined}>
              {l.native}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-foot {
    position: relative;
    margin: 24px;
    padding: clamp(32px, 5vw, 72px);
    border: 1px solid color-mix(in srgb, var(--brand-mark) 18%, var(--site-forest));
    border-radius: 28px;
    background: radial-gradient(ellipse at 0 0, color-mix(in srgb, var(--brand-strong) 48%, transparent), transparent 65%), linear-gradient(135deg, var(--site-forest-raised), var(--site-forest));
    color: var(--on-brand);
    backdrop-filter: blur(24px);
    box-shadow: 0 20px 64px var(--silver-shadow), inset 0 1px color-mix(in srgb, var(--on-brand) 12%, transparent);
    overflow: hidden;
    font-family: var(--font-sans);
  }
  .foot-invite { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding-bottom: 48px; border-bottom: 1px solid color-mix(in srgb, var(--on-brand) 16%, transparent); }
  .foot-eyebrow { margin: 0 0 16px; color: var(--site-glass-muted); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .foot-invite h2 { max-width: 620px; margin: 0; font: 500 clamp(28px, 3.6vw, 48px)/1.1 var(--font-sans); letter-spacing: -.04em; text-wrap: balance; }
  .foot-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; flex-shrink: 0; }
  .foot-actions a { display: inline-flex; justify-content: center; align-items: center; gap: 16px; min-height: 48px; padding: 0 20px; border: 1px solid color-mix(in srgb, var(--on-brand) 26%, transparent); border-radius: 10px; color: var(--on-brand); font-size: 13px; text-decoration: none; }
  .foot-actions .foot-primary { background: var(--surface); color: var(--site-forest); border-color: var(--surface); }
  .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 64px; padding-top: 48px; }
  .brand { display: inline-block; border-radius: 10px; background: var(--surface); }
  .brand img { display: block; width: 180px; height: 60px; object-fit: contain; border-radius: 10px; }
  .foot-brand p { max-width: 310px; margin: 20px 0 0; color: var(--site-glass-muted); font-size: 13px; line-height: 1.7; }
  nav { display: grid; gap: 4px; align-content: start; }
  nav h2 { margin: 0 0 16px; font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--on-brand); }
  nav a { width: fit-content; padding: 7px 0; font-size: 13px; line-height: 1.6; color: var(--site-glass-muted); text-decoration: none; }
  .foot-base { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px 32px; border-top: 1px solid color-mix(in srgb, var(--on-brand) 16%, transparent); margin-top: 48px; padding-top: 24px; font-size: 11px; color: var(--site-glass-muted); }
  .foot-base p { margin: 0; }
  .langs { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; }
  .langs a { display: inline-block; padding-block: 8px; color: var(--site-glass-muted); text-decoration: none; }
  .langs a[aria-current='true'] { color: var(--on-brand); text-decoration: underline; text-underline-offset: 5px; }
  .langs a:not(:lang(en), [aria-current='true']) { font-family: system-ui, sans-serif; }
  nav a:hover, .langs a:hover { color: var(--on-brand); text-decoration: underline; text-underline-offset: 5px; }
  .foot-actions a:hover { background: color-mix(in srgb, var(--on-brand) 12%, transparent); }
  .foot-actions .foot-primary:hover { background: var(--brand-soft); }
  .site-foot :focus-visible { outline: 2px solid var(--on-brand); outline-offset: 5px; }
  @media (width <= 1000px) { .foot-invite { align-items: start; flex-direction: column; gap: 28px; } .foot-grid { gap: 32px; } }
  @media (width <= 640px) { .site-foot { margin: 12px; padding: 32px 24px; border-radius: 20px; } .foot-grid { grid-template-columns: 1fr 1fr; gap: 36px 24px; padding-top: 32px; } .foot-brand { grid-column: 1/-1; } .foot-invite { padding-bottom: 32px; } .foot-base { align-items: start; flex-direction: column; margin-top: 32px; } .foot-invite h2 { font-size: 32px; } }
</style>
