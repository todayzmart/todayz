---
// Footer: wordmark and tagline, company and legal links, languages, and the giant wordmark.
import { LOCALE_INFO, createT, type Locale } from '../i18n/index.ts';
import { pageById, pageLocales, pagePath, type PageId } from '../lib/pages.ts';
import { SITE_LOCALES } from '../lib/site-locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
const year = new Date().getFullYear();

/** Link to a page in the current language when it exists in it, otherwise in English. */
function link(id: PageId): { href: string; hreflang: string | undefined } {
  const target = pageById(id);
  const inLocale = pageLocales(target, SITE_LOCALES).includes(locale);
  return { href: pagePath(target, inLocale ? locale : 'en'), hreflang: inLocale ? undefined : 'en' };
}

const company = (['retailers', 'how', 'pricing', 'about', 'contact'] as const).map((id) => ({ ...link(id), label: t(`nav.${id}`) }));
const legal = (
  [
    ['privacy', 'footer.privacy'],
    ['terms-shoppers', 'footer.terms_shoppers'],
    ['terms-shops', 'footer.terms_shops'],
    ['refunds', 'footer.refunds'],
  ] as const
).map(([id, key]) => ({ ...link(id), label: t(key) }));
const home = pageById('home');
const languages = pageLocales(home, SITE_LOCALES).map((l) => ({ locale: l, href: pagePath(home, l), tag: LOCALE_INFO[l].tag, native: LOCALE_INFO[l].native }));
---

<footer class="site-foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="brand" href={link('home').href}>Today<b>Z</b></a>
      <p>{t('footer.tagline')}</p>
    </div>
    <nav aria-label={t('footer.company')}>
      <h2>{t('footer.company')}</h2>
      {company.map((item) => <a href={item.href} hreflang={item.hreflang}>{item.label}</a>)}
    </nav>
    <nav aria-label={t('footer.legal')}>
      <h2>{t('footer.legal')}</h2>
      {legal.map((item) => <a href={item.href} hreflang={item.hreflang}>{item.label}</a>)}
    </nav>
  </div>
  <div class="foot-base">
    <p>{t('footer.copy', { year })}</p>
    <ul class="langs" aria-label={t('a11y.language')}>
      {
        languages.map((l) => (
          <li>
            <a href={l.href} lang={l.tag} hreflang={l.locale} aria-current={l.locale === locale ? 'true' : undefined}>
              {l.native}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="foot-word" aria-hidden="true"></div>
</footer>

<style>
  .site-foot {
    overflow: hidden;
    padding-top: 72px;
    border-top: 1px solid var(--line);
    background: var(--surface-subtle);
    color: var(--ink-2);
  }

  .foot-grid,
  .foot-base {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font: 700 24px/1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .brand b {
    color: var(--brand-mark);
    font: inherit;
  }

  .foot-brand p {
    max-width: 32ch;
    margin: 12px 0 0;
    font: 400 16px/24px var(--font-sans);
  }

  h2 {
    margin: 0 0 12px;
    color: var(--ink);
    font: 600 14px/20px var(--font-sans);
  }

  nav {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  nav a {
    padding: 6px 0;
    color: var(--ink-2);
    text-decoration: none;
    font: 400 15px/22px var(--font-sans);
  }

  .foot-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 56px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font: 400 14px/20px var(--font-sans);
  }

  .foot-base p {
    margin: 0;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .langs a {
    display: inline-block;
    padding-block: 4px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .langs a[aria-current='true'] {
    color: var(--ink);
    font-weight: 600;
  }

  nav a:hover,
  .langs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* A language name in another script uses the system font, so the page does not download every
     script's web fonts for one word each (see "Marketing exceptions" in site/CLAUDE.md). */
  .langs a:not(:lang(en), [aria-current='true']) {
    font-family: system-ui, sans-serif;
  }

  /* The giant wordmark is a decorative logotype, drawn as generated content so the faint brand tint is
     not measured as body text (WCAG 1.4.3 exempts logotypes); the div is aria-hidden. */
  .foot-word {
    margin-bottom: -0.06em;
    color: color-mix(in srgb, var(--ink) 6%, var(--surface-subtle));
    font: 800 clamp(120px, 22vw, 340px)/0.8 var(--font-display);
    letter-spacing: -0.05em;
    text-align: center;
    white-space: nowrap;
    user-select: none;
  }

  .foot-word::before {
    content: 'Today';
  }

  .foot-word::after {
    content: 'Z';
    color: color-mix(in srgb, var(--brand-mark) 14%, var(--surface-subtle));
  }

  @media (width <= 760px) {
    .site-foot {
      padding-top: 48px;
    }

    .foot-grid,
    .foot-base {
      padding-inline: 16px;
    }

    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }

    .foot-brand {
      grid-column: 1 / -1;
    }

    .foot-base {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 40px;
    }

    .foot-word {
      font-size: 27vw;
    }
  }
</style>
