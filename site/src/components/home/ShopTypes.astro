---
// Who it is for: the six shop types as pastel tiles, each with a product photo on its tint and a line
// (D-269). The tiles are bright-page styles (`.bp .b-types` in bright.css) inside the .lp section.
import type { MessageKey, Translate } from '../../i18n/index.ts';
import { SHOP_TYPES } from './data.ts';

interface Props {
  t: Translate;
}

const { t } = Astro.props;
const types = SHOP_TYPES.map((type, i) => ({
  ...type,
  name: t(`home.types.${i + 1}` as MessageKey),
  desc: t(`home.types.desc.${i + 1}` as MessageKey),
}));
---

<section class="sec sec-subtle" id="types">
  <div class="wrap">
    <div class="sec-head split-head">
      <div>
        <p class="eyebrow">{t('home.types.eyebrow')}</p>
        <h2>{t('home.types.title')}</h2>
      </div>
      <p class="sec-intro">{t('home.types.intro')}</p>
    </div>
    <div class="bp">
      <ul class="b-types">
        {
          types.map((type) => (
            <li data-tint={type.tint}>
              <span class="b-type-photo">
                <img src={type.photo.src} width="240" height="240" alt="" loading="lazy" decoding="async" />
              </span>
              <b>{type.name}</b>
              <p>{type.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
