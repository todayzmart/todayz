---
// Who it is for: the six shop types with a round photo and a line each.
import type { MessageKey, Translate } from '../../i18n/index.ts';
import { SHOP_TYPES } from './data.ts';

interface Props {
  t: Translate;
}

const { t } = Astro.props;
const types = SHOP_TYPES.map((type, i) => ({
  ...type,
  name: t(`home.types.${i + 1}` as MessageKey),
  desc: t(`home.types.desc.${i + 1}` as MessageKey),
}));
---

<section class="sec sec-subtle" id="types">
  <div class="wrap">
    <div class="sec-head split-head">
      <div>
        <p class="eyebrow">{t('home.types.eyebrow')}</p>
        <h2>{t('home.types.title')}</h2>
      </div>
      <p class="sec-intro">{t('home.types.intro')}</p>
    </div>
    <ul class="types">
      {
        types.map((type) => (
          <li data-tint={type.tint}>
            <img class="t-photo" src={type.photo.src} width="64" height="64" alt="" loading="lazy" decoding="async" />
            <b>{type.name}</b>
            <p>{type.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
