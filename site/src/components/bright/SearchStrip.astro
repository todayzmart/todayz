---
// "Things you can search for": two rows of chips moving in opposite directions, each a link to that
// search in the customer app. A curated list, not live searches (01-product-rules.md §11.3). Each row
// is drawn twice for a seamless loop; the copy is hidden from assistive tech and the tab order. The
// pause checkbox works without JavaScript (WCAG 2.2.2); motion stops under prefers-reduced-motion.
import Icon from '../Icon.astro';
import type { MessageKey, Translate } from '../../i18n/index.ts';
import { STRIP } from './data.ts';

interface Props {
  t: Translate;
  appUrl: string;
}

const { t, appUrl } = Astro.props;
const chips = STRIP.map((c, i) => ({ ...c, label: t(`home.strip.${i + 1}` as MessageKey), href: `${appUrl}/search?q=${encodeURIComponent(c.query)}` }));
const rows = [chips, [...chips].reverse()];
---

<section class="b-strip" aria-labelledby="strip-title">
  <h2 id="strip-title">{t('home.strip.title')}</h2>
  <label class="b-strip-pause">
    <input type="checkbox" data-strip-pause />
    <Icon name="pause" size={18} class="when-playing" />
    <Icon name="play" size={18} class="when-paused" />
    <span class="sr-only">{t('home.strip.pause')}</span>
  </label>
  {
    rows.map((row, r) => (
      <div class:list={['b-strip-row', { rev: r === 1 }]}>
        <ul class="b-strip-track">
          {row.map((c) => (
            <li>
              <a href={c.href}>
                <i data-tint={c.tint} />
                {c.label}
              </a>
            </li>
          ))}
          {row.map((c) => (
            <li aria-hidden="true">
              <a href={c.href} tabindex="-1">
                <i data-tint={c.tint} />
                {c.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
