---
// Bright page head (D-262) for the inner pages (how it works, pricing, about, contact, legal, 404): the
// hero's light mint wash (D-267), the title and an optional lead. Notes and actions go in the default
// slot.
interface Props {
  title: string;
  body?: string | undefined;
}

const { title, body } = Astro.props;
---

<section class="b-hero b-page-head">
  <div class="b-w b-hero-in">
    <h1>{title}</h1>
    {body && <p class="b-lead">{body}</p>}
    <slot />
  </div>
</section>
