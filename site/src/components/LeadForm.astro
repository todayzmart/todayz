---
// The shop lead form (the only interactive island besides plain <details>). Needs JavaScript to
// post JSON to POST /v1/public/leads, so the button renders disabled and the script enables it.
// Turnstile renders implicitly and adds the cf-turnstile-response field; the script behind it is
// loaded by Base.astro on pages with a form. An input points at its error (aria-describedby) only
// while the error shows. Requests time out after 15 s, carry one Idempotency-Key per set of
// details (reused on retry), and a missing or failing Turnstile says so instead of waiting.
//   variant "card": a standalone card with its own heading (contact page).
//   variant "cta":  the form alone, labelled by the landing CTA heading (home, for retailers).
import Icon from './Icon.astro';
import { createT, type Locale } from '../i18n/index.ts';
import { resolveLeadEnv } from '../lib/env.ts';
import { pageById, pagePath } from '../lib/pages.ts';

interface Props {
  locale: Locale;
  /** Page id, sent as the lead source. */
  source: string;
  id?: string;
  variant?: 'card' | 'cta';
  /** For variant "cta": the id of the heading that names the form. */
  labelledBy?: string;
}

const { locale, source, id = 'lead', variant = 'card', labelledBy } = Astro.props;
const t = createT(locale);
const { apiUrl, siteKey } = resolveLeadEnv(import.meta.env);
const privacy = pageById('privacy');
// Turnstile ships its own strings for these; for the rest it picks the browser language.
const captchaLanguage = locale === 'en' || locale === 'hi' ? locale : 'auto';
const cta = variant === 'cta';
const titleId = cta ? labelledBy : `${id}-title`;

const fields = [
  { name: 'name', label: t('lead.name'), error: t('lead.err_name'), type: 'text', autocomplete: 'name', inputmode: undefined, max: 80 },
  { name: 'phone', label: t('lead.phone'), error: t('lead.err_phone'), type: 'tel', autocomplete: 'tel', inputmode: 'tel', max: 20 },
  { name: 'shopName', label: t('lead.shop'), error: t('lead.err_shop'), type: 'text', autocomplete: 'organization', inputmode: undefined, max: 120 },
  { name: 'city', label: t('lead.city'), error: t('lead.err_city'), type: 'text', autocomplete: 'address-level2', inputmode: undefined, max: 80 },
] as const;
---

<div class:list={[cta ? 'cta-form' : 'lead tz-card']} id={id}>
  {
    !cta && (
      <>
        <h2 id={titleId}>{t('lead.title')}</h2>
        <p class="intro">{t('lead.intro')}</p>
      </>
    )
  }
  <form
    class="form"
    method="post"
    novalidate
    aria-labelledby={titleId}
    data-density="touch"
    data-lead-form
    data-api={apiUrl}
    data-source={`site:${source}:${locale}`}
    data-sending={t('lead.sending')}
    data-success={t('lead.success')}
    data-error={t('lead.error')}
    data-rejected={t('lead.err_rejected')}
    data-captcha={t('lead.err_captcha')}
    data-captcha-load={t('lead.err_captcha_load')}
  >
    {
      fields.map((f) => (
        <div class="tz-field">
          <label class="tz-field-label" for={`${id}-${f.name}`}>
            {f.label}
          </label>
          <input
            class="tz-input"
            id={`${id}-${f.name}`}
            name={f.name}
            type={f.type}
            autocomplete={f.autocomplete}
            inputmode={f.inputmode}
            maxlength={f.max}
            required
          />
          <p class="tz-field-error" id={`${id}-${f.name}-err`} data-error-for={f.name} hidden>
            {f.error}
          </p>
        </div>
      ))
    }
    <div
      class="cf-turnstile"
      id={`${id}-captcha`}
      role="group"
      tabindex="-1"
      data-sitekey={siteKey}
      data-theme="light"
      data-language={captchaLanguage}
      data-callback="tzTurnstileOk"
      data-error-callback="tzTurnstileError"
    >
    </div>
    <p class="tz-field-error" id={`${id}-captcha-err`} data-error-for="captcha" hidden>{t('lead.err_captcha')}</p>
    <button class:list={cta ? 'btn-xl btn-brand full' : 'tz-btn tz-btn-brand tz-btn-lg'} type="submit" disabled>
      {t('lead.submit')}
      {cta && <Icon name="arrow" />}
    </button>
    <noscript><p class="nojs">{t('lead.nojs')}</p></noscript>
    <p class="status" role="status" aria-live="polite" data-status></p>
    <p class="consent">
      {t('lead.consent')}{' '}
      <a href={pagePath(privacy, 'en')} hreflang={locale === 'en' ? undefined : 'en'}>{t('footer.privacy')}</a>
    </p>
  </form>
</div>

<script>
  import { LEAD_FIELDS, LeadKeys, submitLead, validateLead, type LeadField } from '../lib/leads.ts';

  interface TurnstileWindow {
    turnstile?: { reset: () => void };
    tzTurnstileError?: () => boolean;
    tzTurnstileOk?: () => void;
  }
  const page = window as unknown as TurnstileWindow;
  const forms = [...document.querySelectorAll<HTMLFormElement>('form[data-lead-form]')];
  let captchaFailed = false;

  type Text = 'sending' | 'success' | 'error' | 'rejected' | 'captcha' | 'captchaLoad';
  const text = (form: HTMLFormElement, key: Text) => form.dataset[key] ?? '';
  const loadFailure = (form: HTMLFormElement) => `${text(form, 'error')} ${text(form, 'captchaLoad')}`;

  /** Shows or hides a field's error; the input points at the message only while it is shown. */
  function setError(form: HTMLFormElement, name: string, show: boolean): void {
    const message = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (message) message.hidden = !show;
    const target = name === 'captcha' ? form.querySelector<HTMLElement>('.cf-turnstile') : form.elements.namedItem(name);
    if (!(target instanceof HTMLElement)) return;
    if (show && message?.id) target.setAttribute('aria-describedby', message.id);
    else target.removeAttribute('aria-describedby');
    if (target instanceof HTMLInputElement) {
      target.classList.toggle('tz-input-invalid', show);
      target.setAttribute('aria-invalid', show ? 'true' : 'false');
    }
  }

  // Turnstile calls these by name (data-error-callback, data-callback) on every widget.
  page.tzTurnstileError = () => {
    captchaFailed = true;
    for (const form of forms) {
      const status = form.querySelector<HTMLElement>('[data-status]');
      if (status && form.dataset['state'] !== 'sending') status.textContent = loadFailure(form);
    }
    return true; // handled: Turnstile does not throw
  };
  page.tzTurnstileOk = () => {
    if (!captchaFailed) return;
    captchaFailed = false;
    for (const form of forms) {
      const status = form.querySelector<HTMLElement>('[data-status]');
      if (status?.textContent === loadFailure(form)) status.textContent = '';
    }
  };

  for (const form of forms) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');
    const keys = new LeadKeys();
    const say = (message: string) => {
      if (status) status.textContent = message;
    };
    if (button) button.disabled = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset['state'] === 'sending') return;
      const data = new FormData(form);
      const raw: Partial<Record<LeadField, string>> = {};
      for (const f of LEAD_FIELDS) raw[f] = String(data.get(f) ?? '');
      const result = validateLead(raw);
      for (const f of LEAD_FIELDS) setError(form, f, !result.ok && result.errors[f] === true);
      // The check could not load (blocked script, network) or reported an error: no token will come.
      const checkBroken = page.turnstile === undefined || captchaFailed;
      const token = String(data.get('cf-turnstile-response') ?? '');
      const needToken = !checkBroken && token === '';
      setError(form, 'captcha', needToken);
      if (!result.ok || checkBroken || needToken) {
        say(checkBroken ? loadFailure(form) : needToken ? text(form, 'captcha') : '');
        const invalid = form.querySelector<HTMLInputElement>('[aria-invalid="true"]');
        if (invalid) invalid.focus();
        else if (needToken) widget?.focus();
        return;
      }
      form.dataset['state'] = 'sending';
      if (button) button.disabled = true;
      say(text(form, 'sending'));
      const outcome = await submitLead(
        form.dataset['api'] ?? '',
        { ...result.value, source: form.dataset['source'] ?? 'site', turnstileToken: token },
        { idempotencyKey: keys.keyFor(result.value) },
      );
      if (outcome.ok) {
        keys.reset();
        form.reset();
        say(text(form, 'success'));
        form.dataset['state'] = 'sent';
      } else {
        say(text(form, outcome.reason === 'rejected' ? 'rejected' : 'error'));
        form.dataset['state'] = 'failed';
      }
      if (button) button.disabled = false;
      // A token is single use: get a fresh one for the next attempt.
      page.turnstile?.reset();
    });
  }
</script>

<style>
  .lead {
    display: grid;
    gap: var(--space-4);
    max-width: 520px;
    padding: var(--space-6);
    box-shadow: var(--shadow-pop);
  }

  h2 {
    margin: 0;
    font: var(--type-title);
    letter-spacing: var(--type-title-tracking);
    color: var(--ink);
  }

  .intro {
    margin: 0;
    color: var(--ink-2);
    font: var(--type-body);
  }

  .form {
    display: grid;
    gap: var(--space-4);
  }

  /* Landing CTA: the form sits in a white card on the green CTA band. */
  .cta-form {
    padding: 28px;
    border-radius: 24px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 40px 80px -30px color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .cta-form .form {
    gap: 14px;
  }

  .cta-form .tz-input {
    min-height: 48px;
    border-radius: 12px;
    font-size: 16px;
  }

  .status {
    min-height: 1.5em;
    margin: 0;
    color: var(--ink);
    font: var(--type-label);
  }

  .status:empty {
    min-height: 0;
  }

  .nojs {
    margin: 0;
    color: var(--ink-2);
    font: var(--type-label);
  }

  .consent {
    margin: 0;
    color: var(--ink-3);
    font: var(--type-caption);
  }

  .consent a {
    color: var(--ink-2);
  }

  @media (width <= 760px) {
    .cta-form {
      padding: 20px;
    }
  }
</style>
