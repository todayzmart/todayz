---
// FAQ as native <details>, no JavaScript. Items are plain {q, a} pairs; pages also pass them to JSON-LD.
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  /** Open the first answer (the landing pages do). */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          <span>{item.q}</span>
          <Icon name="chevron" class="chev" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
    max-width: 760px;
  }

  details {
    border: 1px solid transparent;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  details[open] {
    background: var(--surface);
    box-shadow: var(--shadow-pop);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--tap-min);
    padding: 20px 24px;
    color: var(--ink);
    font: 600 18px/24px var(--font-sans);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(.chev) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--ink-3);
    transition: transform 160ms ease;
  }

  details[open] summary :global(.chev) {
    transform: rotate(180deg);
  }

  p {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--ink-2);
    font: 400 16px/24px var(--font-sans);
  }

  @media (width <= 760px) {
    summary {
      padding: 18px;
      font-size: 16px;
    }

    p {
      padding: 0 18px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    summary :global(.chev) {
      transition: none;
    }
  }
</style>
