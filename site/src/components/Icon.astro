---
// Lucide icon as inline SVG (stroke 1.75 like the apps). Only the icons the site uses are imported.
import {
  ArrowRight,
  Banknote,
  Bell,
  Bike,
  Box,
  CalendarCheck,
  Cable,
  Candy,
  Croissant,
  Droplets,
  Headphones,
  Milk,
  Soup,
  ChartColumn,
  Check,
  ChevronDown,
  ClipboardList,
  Clock,
  Coins,
  CreditCard,
  Footprints,
  Gift,
  Globe,
  Hammer,
  Hourglass,
  IndianRupee,
  LayoutDashboard,
  Leaf,
  MapPin,
  Menu,
  Navigation,
  Package,
  PackageSearch,
  Pause,
  Pencil,
  Pill,
  Play,
  Plug,
  Plus,
  ReceiptIndianRupee,
  RotateCcw,
  ScanBarcode,
  Search,
  SearchX,
  ShoppingBag,
  ShoppingBasket,
  Smartphone,
  Sparkles,
  Store,
  Tag,
  Ticket,
  TrendingUp,
  TriangleAlert,
  Truck,
  Users,
  WifiOff,
} from 'lucide';

const icons = {
  alert: TriangleAlert,
  cable: Cable,
  candy: Candy,
  bread: Croissant,
  drops: Droplets,
  headphones: Headphones,
  milk: Milk,
  soup: Soup,
  arrow: ArrowRight,
  bag: ShoppingBag,
  basket: ShoppingBasket,
  bell: Bell,
  bike: Bike,
  booking: CalendarCheck,
  box: Box,
  card: CreditCard,
  cash: Banknote,
  chart: ChartColumn,
  check: Check,
  chevron: ChevronDown,
  credit: Ticket,
  dash: LayoutDashboard,
  delivery: Truck,
  demand: PackageSearch,
  gift: Gift,
  globe: Globe,
  growth: TrendingUp,
  hammer: Hammer,
  hourglass: Hourglass,
  menu: Menu,
  orders: ClipboardList,
  package: Package,
  pause: Pause,
  pencil: Pencil,
  phone: Smartphone,
  pill: Pill,
  play: Play,
  pin: MapPin,
  plug: Plug,
  plus: Plus,
  receipt: ReceiptIndianRupee,
  scan: ScanBarcode,
  search: Search,
  'search-x': SearchX,
  sparkles: Sparkles,
  store: Store,
  tag: Tag,
  users: Users,
  'wifi-off': WifiOff,
  coins: Coins,
  footprints: Footprints,
  leaf: Leaf,
  replay: RotateCcw,
  rupee: IndianRupee,
  clock: Clock,
  route: Navigation,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  /** Extra class names; the base class tz-ico is always set. */
  class?: string;
}

const { name, size = 20, class: extra } = Astro.props;
const nodes = icons[name] as unknown as [string, Record<string, string | number>][];
---

<svg
  class:list={['tz-ico', extra]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nodes.map(([tag, attrs]) => {
      const Tag = tag;
      return <Tag {...attrs} />;
    })
  }
</svg>
