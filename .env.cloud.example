# Names only (D-210): the lead's cloud credentials live in .env.cloud.local (git-ignored),
# read by the lead's shell for gh, aws, terraform and wrangler. `make env-check` lists each
# name as set or missing, never a value. Worker sessions never need these.
GITHUB_OWNER=
GH_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BUDGET_ALERT_EMAIL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_OTP_TEMPLATE_ID=
SMS_NOTICE_TEMPLATE_IDS=
# D-275 Firebase phone sign-in: the four public web-config values (docs/runbooks/firebase-phone-auth.md).
# The lead copies them into the prod extra_properties with OTP_PROVIDER=firebase.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
