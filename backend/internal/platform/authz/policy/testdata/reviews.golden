# domain reviews: one line per (role x action); regenerate with -update
me.reviews.view kind=customer step-up=false
me.reviews.manage kind=customer step-up=false
reviews.view kind=business step-up=false
reviews.view owner allow
reviews.view manager allow
reviews.view cashier -
review.reply kind=business step-up=false
review.reply owner allow
review.reply manager allow
review.reply cashier -
review.report kind=business step-up=false
review.report owner allow
review.report manager allow
review.report cashier -
admin.review.moderate kind=admin step-up=false
admin.review.moderate field_agent -
admin.review.moderate support allow
admin.review.moderate catalogue -
admin.review.moderate analyst -
admin.review.moderate finance -
admin.review.moderate admin allow
admin.review.moderate super_admin allow
admin.review.restore kind=admin step-up=false
admin.review.restore field_agent -
admin.review.restore support allow
admin.review.restore catalogue -
admin.review.restore analyst -
admin.review.restore finance -
admin.review.restore admin allow
admin.review.restore super_admin allow
