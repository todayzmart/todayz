# TodayZ environment variables: NAMES ONLY. Never put a value in this file.
#
# Local: `make setup` writes the app keys below into .env.local (git-ignored)
# and prints only "generated: NAME". `make env-check` prints NAME set|missing.
# Staging/prod: values come from AWS Secrets Manager (Wave 5).
# Provider keys are optional locally; the default suite runs on the mocks (D-17).

# --- Runtime -----------------------------------------------------------------
# local | test | staging | prod (there is no "dev", D-15)
APP_ENV=
APP_VERSION=
API_PUBLIC_URL=
LOG_LEVEL=
# Listen addresses (local 127.0.0.1:8180 / 127.0.0.1:8181; deployed :8080 / :8081)
API_ADDR=
WORKER_ADDR=

# --- Database (local: Docker PostGIS on host port 5433) ----------------------
DATABASE_URL=
DATABASE_MIGRATE_URL=

# --- App keys (D-18; generated by make setup) --------------------------------
# JSON key set of Ed25519 keys with kid, written in single quotes
JWT_SIGNING_KEYS=
JWT_CURRENT_KID=
ORDER_CODE_ENC_KEY=
ORDER_CODE_HMAC_KEY=
BILL_QR_SIGNING_KEY=
PII_ENC_KEY=
PII_HASH_KEY=
DEVICE_SECRET_ENC_KEY=
TOTP_ENC_KEY=

# --- Storage (local: MinIO stands in for R2) ---------------------------------
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGES=
R2_BUCKET_PRIVATE=
R2_BUCKET_TILES=

# --- Telemetry (local: grafana/otel-lgtm) ------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=

# --- Providers (optional locally; mocks by default) --------------------------
# *_API_URL point at e2e/mocks locally (mocks.todayz.localhost). Names avoid SDK
# defaults (e.g. ANTHROPIC_BASE_URL) so a value exported by another tool is never picked up.
SMS_API_URL=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
PUSH_API_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TURNSTILE_API_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
STT_API_URL=
SARVAM_API_KEY=
LLM_API_URL=
ANTHROPIC_API_KEY=
# 1 = recorded fixtures (default); 0 = live model, only with your own key
MOCK_LLM=
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# --- Frontends (Vite; public values only, never secrets) ---------------------
VITE_API_URL=
VITE_TILES_URL=
VITE_IMG_URL=
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=

# --- Cloud (Wave 5 only; Terraform and CI, never read by the app) ------------
AWS_REGION=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
