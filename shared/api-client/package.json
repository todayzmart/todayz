{
  "name": "@todayz/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client, Zod schemas and MSW handlers generated from the bundled backend/api/openapi.yaml, plus the fetch wrapper they call (W0-04). src/gen and src/mocks/handlers.gen.ts are generated by make gen and git-ignored.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./gen/*": "./src/gen/*.ts",
    "./mocks": "./src/mocks/index.ts"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs bundle",
    "gen": "node scripts/gen.mjs",
    "lint:spec": "node scripts/bundle.mjs lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "msw": "2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redocly/cli": "2.60.0",
    "@todayz/config": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "msw": "2.15.0",
    "orval": "8.40.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
