{
  "name": "@todayz/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens, the tz- component CSS and self-hosted fonts, generated from design/source (W0-05).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./generated/tokens.ts",
    "./tokens.css": "./generated/tokens.css",
    "./bundle.css": "./generated/bundle.css",
    "./fonts.css": "./generated/fonts.css",
    "./styles.css": "./styles.css",
    "./tokens.json": "./generated/tokens.json",
    "./icons/*": "./generated/icons/*",
    "./fonts/*": "./generated/fonts/*",
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    },
    "./css-vars": {
      "types": "./src/css-vars.d.mts",
      "default": "./src/css-vars.mjs"
    }
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@fontsource-variable/anek-devanagari": "5.3.0",
    "@fontsource-variable/anek-kannada": "5.3.0",
    "@fontsource-variable/anek-latin": "5.3.0",
    "@fontsource-variable/anek-tamil": "5.3.0",
    "@fontsource-variable/anek-telugu": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-kannada": "5.3.0",
    "@fontsource-variable/noto-sans-tamil": "5.3.0",
    "@fontsource-variable/noto-sans-telugu": "5.3.0"
  },
  "devDependencies": {
    "@todayz/config": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
