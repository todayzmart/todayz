  "help.how.title": {
    "message": "TodayZ ನಿಮ್ಮ ಅಂಗಡಿಗೆ ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ",
    "review": "machine",
    "enHash": "51eee93d"
  },
  "help.how.stock.title": {
    "message": "ನಿಮ್ಮ ಸ್ಟಾಕ್ ಆನ್‌ಲೈನ್‌ಗೆ ಹಾಕಿ",
    "review": "machine",
    "enHash": "3da87e1e"
  },
  "help.how.stock.body": {
    "message": "ಬೆಲೆ ಮತ್ತು ನಿಮ್ಮಲ್ಲಿ ಎಷ್ಟಿದೆ ಎಂಬುದರೊಂದಿಗೆ ಪ್ರಾಡಕ್ಟ್‌ಗಳನ್ನು ಸೇರಿಸಿ. ಹತ್ತಿರದ ಗ್ರಾಹಕರು ಸ್ಟಾಕ್‌ನಲ್ಲಿ ಏನಿದೆ ಎಂದು ನೋಡುತ್ತಾರೆ.",
    "review": "machine",
    "enHash": "92183b71"
  },
  "help.how.orders.title": {
    "message": "ಆರ್ಡರ್‌ಗಳನ್ನು ಸಮಯಕ್ಕೆ ಸ್ವೀಕರಿಸಿ",
    "review": "machine",
    "enHash": "fbf2a640"
  },
  "help.how.orders.body": {
    "message": "ಹೊಸ ಆರ್ಡರ್ ಆರ್ಡರ್‌ಗಳ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ರಿಂಗ್ ಆಗುತ್ತದೆ. ಅದರ ಟೈಮರ್ ಮುಗಿಯುವ ಮೊದಲು ಅದನ್ನು ಸ್ವೀಕರಿಸಿ, ಅದರ ಒಂದು ಭಾಗ ತೆಗೆದುಕೊಳ್ಳಿ, ಅಥವಾ ಏಕೆ ಆಗುವುದಿಲ್ಲ ಎಂದು ತಿಳಿಸಿ.",
    "review": "machine",
    "enHash": "19618d44"
  },
  "help.how.pickup.title": {
    "message": "ಕೋಡ್‌ನೊಂದಿಗೆ ಹಸ್ತಾಂತರಿಸಿ",
    "review": "machine",
    "enHash": "dae79fb9"
  },
  "help.how.pickup.body": {
    "message": "ಪಿಕಪ್ ವೇಳೆ ಗ್ರಾಹಕರು ಒಂದು ಕೋಡ್ ತೋರಿಸುತ್ತಾರೆ. ಹಸ್ತಾಂತರ ಮುಗಿಸಲು ಅದನ್ನು ಆರ್ಡರ್‌ನಲ್ಲಿ ನಮೂದಿಸಿ.",
    "review": "machine",
    "enHash": "fd9928c1"
  },
  "help.how.counter.title": {
    "message": "ಕೌಂಟರ್‌ನಲ್ಲಿ ಮಾರಾಟ ಮಾಡಿ",
    "review": "machine",
    "enHash": "db51c22c"
  },
  "help.how.counter.body": {
    "message": "ಅಂಗಡಿಗೆ ಬಂದ ಗ್ರಾಹಕರ ಮಾರಾಟವನ್ನು 'ಮಾರಾಟ'ದಲ್ಲಿ ದಾಖಲಿಸಿ, ಆಫ್‌ಲೈನ್‌ನಲ್ಲೂ. ಮಾರಿದಂತೆ ಸ್ಟಾಕ್ ಕಡಿಮೆಯಾಗುತ್ತದೆ.",
    "review": "machine",
    "enHash": "3b0c40dc"
  },
  "help.how.credits.title": {
    "message": "ಕ್ರೆಡಿಟ್‌ಗಳು ಗ್ರಾಹಕರನ್ನು ಮತ್ತೆ ಕರೆತರುತ್ತವೆ",
    "review": "machine",
    "enHash": "fdbf56ad"
  },
  "help.how.credits.body": {
    "message": "ಗ್ರಾಹಕರು TodayZ ಕ್ರೆಡಿಟ್ ಗಳಿಸುತ್ತಾರೆ ಮತ್ತು ಖರ್ಚು ಮಾಡುತ್ತಾರೆ. ನಿಮ್ಮ ಅಂಗಡಿಯಲ್ಲಿ ಅವರು ಖರ್ಚು ಮಾಡಿದ್ದು ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಖಾತೆಗೆ ಸೇರುತ್ತದೆ.",
    "review": "machine",
    "enHash": "183c358e"
  },
  "help.how.payouts.title": {
    "message": "ಹಣ ಪಡೆಯಿರಿ",
    "review": "machine",
    "enHash": "d68abf9e"
  },
  "help.how.payouts.body": {
    "message": "ಪ್ರತಿ ತಿಂಗಳು ಒಂದು ಸ್ಟೇಟ್‌ಮೆಂಟ್ ಮುಕ್ತಾಯವಾಗುತ್ತದೆ ಮತ್ತು ನಿಮಗೆ ಬರಬೇಕಾದ ಹಣವನ್ನು UPI ಮೂಲಕ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.",
    "review": "machine",
    "enHash": "ddfb737e"
  },
  "help.faq.title": {
    "message": "ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆಗಳು",
    "review": "machine",
    "enHash": "f07ac22a"
  },
  "help.faq.timer.q": {
    "message": "ನಾನು ಆರ್ಡರ್ ಅನ್ನು ಸಮಯಕ್ಕೆ ಸ್ವೀಕರಿಸದಿದ್ದರೆ ಏನಾಗುತ್ತದೆ?",
    "review": "machine",
    "enHash": "a5eda5e3"
  },
  "help.faq.timer.a": {
    "message": "ಆರ್ಡರ್‌ನ ಸಮಯ ಮುಗಿಯುತ್ತದೆ ಮತ್ತು ಗ್ರಾಹಕರಿಗೆ ತಿಳಿಸಲಾಗುತ್ತದೆ. ತಪ್ಪಿದ ಆರ್ಡರ್‌ಗಳಿಂದ ಹುಡುಕಾಟದಲ್ಲಿ ನಿಮ್ಮ ಅಂಗಡಿ ಕೆಳಗೆ ಕಾಣುತ್ತದೆ, ಆದ್ದರಿಂದ ಅಂಗಡಿ ತೆರೆದಿರುವಾಗ ಆರ್ಡರ್‌ಗಳ ಸ್ಕ್ರೀನ್ ತೆರೆದಿಡಿ.",
    "review": "machine",
    "enHash": "d7f43596"
  },
  "help.faq.code.q": {
    "message": "ಪಿಕಪ್ ಕೋಡ್ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ",
    "review": "machine",
    "enHash": "e7c8c075"
  },
  "help.faq.code.a": {
    "message": "ಆರ್ಡರ್ ಸ್ವೀಕರಿಸಿದ ಅಥವಾ ಸಿದ್ಧವಾದಾಗ ಮಾತ್ರ ಕೋಡ್ ಕೆಲಸ ಮಾಡುತ್ತದೆ, ಅದೂ ಒಂದೇ ಬಾರಿ. ಹಲವು ತಪ್ಪು ಪ್ರಯತ್ನಗಳ ನಂತರ ಅದು ಲಾಕ್ ಆಗುತ್ತದೆ: ಗ್ರಾಹಕರ ಆ್ಯಪ್‌ನಲ್ಲಿ \"ಹೊಸ ಕೋಡ್\" ಒತ್ತಲು ಹೇಳಿ.",
    "review": "machine",
    "enHash": "b5440c50"
  },
  "help.faq.credits.q": {
    "message": "ಗ್ರಾಹಕರು ಖರ್ಚು ಮಾಡುವ ಕ್ರೆಡಿಟ್‌ಗಳು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತವೆ?",
    "review": "machine",
    "enHash": "1f93d430"
  },
  "help.faq.credits.a": {
    "message": "ಗ್ರಾಹಕರು ನಿಮ್ಮ ಅಂಗಡಿಯಲ್ಲಿ ಖರ್ಚು ಮಾಡುವ ಕ್ರೆಡಿಟ್‌ಗಳು ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಖಾತೆಗೆ ಹೋಗುತ್ತವೆ ಮತ್ತು ನಿಮ್ಮ ಪೇಔಟ್ ಜೊತೆ ಪಾವತಿಯಾಗುತ್ತವೆ. ನೀವು ಕೊಡುವ ಕ್ಯಾಶ್‌ಬ್ಯಾಕ್ ಕೂಡ ಇದೇ ಖಾತೆಯಿಂದ ಹೋಗುತ್ತದೆ.",
    "review": "machine",
    "enHash": "f50ee125"
  },
  "help.faq.payout.q": {
    "message": "ನನಗೆ ಹಣ ಯಾವಾಗ ಸಿಗುತ್ತದೆ?",
    "review": "machine",
    "enHash": "dcac7e28"
  },
  "help.faq.payout.a": {
    "message": "ಪ್ರತಿ ತಿಂಗಳ 1ನೇ ತಾರೀಖು ಸ್ಟೇಟ್‌ಮೆಂಟ್ ಮುಕ್ತಾಯವಾಗುತ್ತದೆ. ನಿಮಗೆ ಬರಬೇಕಾದ ಹಣವನ್ನು UPI ಮೂಲಕ ಕಳುಹಿಸಲಾಗುತ್ತದೆ, ಮತ್ತು ಕ್ರೆಡಿಟ್ ಸ್ಕ್ರೀನ್ ಅದನ್ನು UTR ಸಂಖ್ಯೆಯೊಂದಿಗೆ ಕಳುಹಿಸಲಾಗಿದೆ ಎಂದು ತೋರಿಸುತ್ತದೆ. ನಿಮ್ಮ ವೆರಿಫಿಕೇಶನ್ ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೆ ಪೇಔಟ್ ತಡೆಹಿಡಿಯಲಾಗುತ್ತದೆ.",
    "review": "machine",
    "enHash": "7854109f"
  },
  "help.faq.visible.q": {
    "message": "ಗ್ರಾಹಕರಿಗೆ ನನ್ನ ಅಂಗಡಿ ಏಕೆ ಕಾಣುತ್ತಿಲ್ಲ?",
    "review": "machine",
    "enHash": "1b41376a"
  },
  "help.faq.visible.a": {
    "message": "ನಿಮ್ಮ ಅಂಗಡಿ ಅನುಮೋದಿತ, ಲೈವ್ ಮತ್ತು ತೆರೆದಿದ್ದಾಗ ಮಾತ್ರ ಕಾಣುತ್ತದೆ, ಮತ್ತು ಹುಡುಕಾಟದಲ್ಲಿ ಸ್ಟಾಕ್ ಇರುವ ಪ್ರಾಡಕ್ಟ್‌ಗಳು ಮಾತ್ರ ಕಾಣುತ್ತವೆ.",
    "review": "machine",
    "enHash": "f4e2ecf1"
  },
  "help.faq.staff.q": {
    "message": "ನನ್ನ ಸಿಬ್ಬಂದಿ ಏನು ಮಾಡಬಹುದು?",
    "review": "machine",
    "enHash": "b8db285c"
  },
  "help.faq.staff.a": {
    "message": "ಕ್ಯಾಷಿಯರ್ ಮಾರಾಟ ಮಾಡುತ್ತಾರೆ ಮತ್ತು ಆರ್ಡರ್‌ಗಳನ್ನು ನೋಡಿಕೊಳ್ಳುತ್ತಾರೆ. ಮ್ಯಾನೇಜರ್ ಸ್ಟಾಕ್, ಆಫರ್ ಮತ್ತು ಕ್ಯಾಷಿಯರ್‌ಗಳನ್ನೂ ನಿರ್ವಹಿಸುತ್ತಾರೆ. ಮಾಲೀಕರು ಪೇಔಟ್ ಮತ್ತು ಮ್ಯಾನೇಜರ್‌ಗಳು ಸೇರಿದಂತೆ ಎಲ್ಲವನ್ನೂ ಮಾಡಬಹುದು.",
    "review": "machine",
    "enHash": "3fa92516"
  },
  "help.faq.close.q": {
    "message": "ನನ್ನ ಬಿಸಿನೆಸ್ ಅನ್ನು ಹೇಗೆ ಮುಚ್ಚುವುದು?",
    "review": "machine",
    "enHash": "9cbd77ce"
  },
  "help.faq.close.a": {
    "message": "ಆ್ಯಪ್‌ನಲ್ಲಿ ಅಳಿಸುವ ಆಯ್ಕೆ ಇಲ್ಲ. ಸಪೋರ್ಟ್ ಅನ್ನು ಸಂಪರ್ಕಿಸಿ, ನಾವು ಸಹಾಯ ಮಾಡುತ್ತೇವೆ.",
    "review": "machine",
    "enHash": "c0c9b9a3"
  },
  "help.contact.title": {
    "message": "ಸಪೋರ್ಟ್ ಸಂಪರ್ಕಿಸಿ",
    "review": "machine",
    "enHash": "2b658ffd"
  },
  "help.contact.body": {
    "message": "ಟಿಕೆಟ್ ತೆರೆಯಿರಿ, ಸಪೋರ್ಟ್ ಇಲ್ಲೇ ಆ್ಯಪ್‌ನಲ್ಲಿ ಉತ್ತರಿಸುತ್ತದೆ. ಸಹಾಯವಾದರೆ ಆರ್ಡರ್ ಮತ್ತು ಫೋಟೋ ಸೇರಿಸಿ.",
