    "review": "machine",
    "enHash": "51eee93d"
  },
  "help.how.stock.title": {
    "message": "உங்கள் ஸ்டாக்கை ஆன்லைனில் வையுங்கள்",
    "review": "machine",
    "enHash": "3da87e1e"
  },
  "help.how.stock.body": {
    "message": "விலை மற்றும் உங்களிடம் எத்தனை உள்ளன என்பதுடன் பொருட்களைச் சேர்க்கவும். அருகிலுள்ள வாடிக்கையாளர்கள் ஸ்டாக்கில் என்ன உள்ளது என்று பார்ப்பார்கள்.",
    "review": "machine",
    "enHash": "92183b71"
  },
  "help.how.orders.title": {
    "message": "ஆர்டர்களை நேரத்தில் ஏற்கவும்",
    "review": "machine",
    "enHash": "fbf2a640"
  },
  "help.how.orders.body": {
    "message": "புதிய ஆர்டர் ஆர்டர்கள் திரையில் ஒலிக்கும். அதன் டைமர் முடியும் முன் அதை ஏற்கவும், அதில் ஒரு பகுதியை எடுக்கவும், அல்லது ஏன் முடியாது என்று சொல்லவும்.",
    "review": "machine",
    "enHash": "19618d44"
  },
  "help.how.pickup.title": {
    "message": "குறியீட்டுடன் ஒப்படைக்கவும்",
    "review": "machine",
    "enHash": "dae79fb9"
  },
  "help.how.pickup.body": {
    "message": "பிக்கப்பின் போது வாடிக்கையாளர் ஒரு குறியீட்டைக் காட்டுவார். ஒப்படைப்பை முடிக்க அதை ஆர்டரில் உள்ளிடவும்.",
    "review": "machine",
    "enHash": "fd9928c1"
  },
  "help.how.counter.title": {
    "message": "கவுண்டரில் விற்கவும்",
    "review": "machine",
    "enHash": "db51c22c"
  },
  "help.how.counter.body": {
    "message": "கடைக்கு வரும் வாடிக்கையாளர்களின் விற்பனையை 'விற்பனை'யில் பதிவு செய்யுங்கள், ஆஃப்லைனிலும். விற்கும்போதே ஸ்டாக் குறையும்.",
    "review": "machine",
    "enHash": "3b0c40dc"
  },
  "help.how.credits.title": {
    "message": "கிரெடிட் வாடிக்கையாளர்களை மீண்டும் கொண்டுவரும்",
    "review": "machine",
    "enHash": "fdbf56ad"
  },
  "help.how.credits.body": {
    "message": "வாடிக்கையாளர்கள் TodayZ கிரெடிட் சம்பாதித்து செலவழிக்கிறார்கள். உங்கள் கடையில் அவர்கள் செலவழிப்பது உங்கள் கிரெடிட் கணக்கில் சேரும்.",
    "review": "machine",
    "enHash": "183c358e"
  },
  "help.how.payouts.title": {
    "message": "பணம் பெறுங்கள்",
    "review": "machine",
    "enHash": "d68abf9e"
  },
  "help.how.payouts.body": {
    "message": "ஒவ்வொரு மாதமும் ஒரு ஸ்டேட்மென்ட் முடிகிறது, உங்களுக்கு வர வேண்டிய தொகை UPI மூலம் அனுப்பப்படும்.",
    "review": "machine",
    "enHash": "ddfb737e"
  },
  "help.faq.title": {
    "message": "பொதுவான கேள்விகள்",
    "review": "machine",
    "enHash": "f07ac22a"
  },
  "help.faq.timer.q": {
    "message": "ஆர்டரை நேரத்தில் ஏற்காவிட்டால் என்ன ஆகும்?",
    "review": "machine",
    "enHash": "a5eda5e3"
  },
  "help.faq.timer.a": {
    "message": "ஆர்டரின் நேரம் முடிந்துவிடும், வாடிக்கையாளருக்குத் தெரிவிக்கப்படும். தவறவிட்ட ஆர்டர்களால் தேடலில் உங்கள் கடை கீழே காட்டப்படும், எனவே கடை திறந்திருக்கும் வரை ஆர்டர்கள் திரையைத் திறந்து வையுங்கள்.",
    "review": "machine",
    "enHash": "d7f43596"
  },
  "help.faq.code.q": {
    "message": "பிக்கப் குறியீடு வேலை செய்யவில்லை",
    "review": "machine",
    "enHash": "e7c8c075"
  },
  "help.faq.code.a": {
    "message": "ஆர்டர் ஏற்கப்பட்டு அல்லது தயாராக இருக்கும்போது மட்டுமே குறியீடு வேலை செய்யும், அதுவும் ஒரு முறை மட்டும். பல தவறான முயற்சிகளுக்குப் பிறகு அது பூட்டப்படும்: வாடிக்கையாளரிடம் அவர்களின் ஆப்பில் \"புதிய குறியீடு\" என்பதைத் தட்டச் சொல்லுங்கள்.",
    "review": "machine",
    "enHash": "b5440c50"
  },
  "help.faq.credits.q": {
    "message": "வாடிக்கையாளர்கள் செலவழிக்கும் கிரெடிட் எங்கே போகும்?",
    "review": "machine",
    "enHash": "1f93d430"
  },
  "help.faq.credits.a": {
    "message": "வாடிக்கையாளர் உங்கள் கடையில் செலவழிக்கும் கிரெடிட் உங்கள் கிரெடிட் கணக்குக்குச் சென்று, உங்கள் பணம் வழங்கலுடன் செலுத்தப்படும். நீங்கள் தரும் கேஷ்பேக்கும் இதே கணக்கிலிருந்து போகும்.",
    "review": "machine",
    "enHash": "f50ee125"
  },
  "help.faq.payout.q": {
    "message": "எனக்கு எப்போது பணம் கிடைக்கும்?",
    "review": "machine",
    "enHash": "dcac7e28"
  },
  "help.faq.payout.a": {
    "message": "ஒவ்வொரு மாதமும் 1ஆம் தேதி ஸ்டேட்மென்ட் முடிகிறது. உங்களுக்கு வர வேண்டிய தொகை UPI மூலம் அனுப்பப்படும், கிரெடிட் திரை அதை UTR எண்ணுடன் வழங்கப்பட்டதாகக் காட்டும். உங்கள் சரிபார்ப்பு முடியும் வரை பணம் வழங்கல் நிறுத்திவைக்கப்படும்.",
    "review": "machine",
    "enHash": "7854109f"
  },
  "help.faq.visible.q": {
    "message": "வாடிக்கையாளர்களுக்கு என் கடை ஏன் தெரியவில்லை?",
    "review": "machine",
    "enHash": "1b41376a"
  },
  "help.faq.visible.a": {
    "message": "உங்கள் கடை அங்கீகரிக்கப்பட்டு, லைவ்வாக, திறந்திருக்கும்போது மட்டுமே தெரியும், தேடலில் ஸ்டாக் உள்ள பொருட்கள் மட்டுமே தெரியும்.",
    "review": "machine",
    "enHash": "f4e2ecf1"
  },
  "help.faq.staff.q": {
    "message": "என் ஊழியர்கள் என்ன செய்யலாம்?",
    "review": "machine",
    "enHash": "b8db285c"
  },
  "help.faq.staff.a": {
    "message": "காசாளர் விற்பார், ஆர்டர்களைக் கவனிப்பார். மேலாளர் ஸ்டாக், ஆஃபர்கள், காசாளர்களையும் கவனிப்பார். உரிமையாளர் பணம் வழங்கல், மேலாளர்கள் உட்பட எல்லாவற்றையும் செய்யலாம்.",
    "review": "machine",
    "enHash": "3fa92516"
  },
  "help.faq.close.q": {
    "message": "என் பிசினஸை எப்படி மூடுவது?",
    "review": "machine",
    "enHash": "9cbd77ce"
  },
  "help.faq.close.a": {
    "message": "ஆப்பில் நீக்கும் வசதி இல்லை. சப்போர்ட்டைத் தொடர்புகொள்ளுங்கள், நாங்கள் உதவுவோம்.",
    "review": "machine",
    "enHash": "c0c9b9a3"
  },
  "help.contact.title": {
    "message": "சப்போர்ட்டைத் தொடர்புகொள்ளுங்கள்",
    "review": "machine",
    "enHash": "2b658ffd"
  },
  "help.contact.body": {
    "message": "டிக்கெட் திறங்கள், சப்போர்ட் இங்கேயே ஆப்பில் பதில் தரும். உதவும் என்றால் ஆர்டரையும் புகைப்படத்தையும் சேர்க்கவும்.",
    "review": "machine",
    "enHash": "6005ef8c"
