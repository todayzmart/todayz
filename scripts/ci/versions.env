# Pinned CI tool versions and container images (W0-06). Sourced by scripts/ci/*.sh.
# Every pin is at least two weeks old when added. Images are pinned by the digest of
# their multi-arch index, so the same pin works on amd64 runners and arm64 Macs (Colima).
# Go and pnpm are NOT pinned here: they come from the repo (go.mod, package.json);
# see scripts/ci/toolchain.sh.
# shellcheck disable=SC2034 # read by the scripts that source this file

# Node for CI runners: the current LTS line (24). The repo's engines.node stays
# ">=22.12" for local machines; toolchain.sh checks this pin satisfies it. A
# .node-version or .nvmrc file, if one is ever added, wins over this.
NODE_CI_VERSION=24

# Installed with `go install <module>@<version>` (checksummed by the Go module proxy).
ACTIONLINT_VERSION=v1.7.12            # 2026-03-30
GITLEAKS_VERSION=v8.30.1              # 2026-03-21
LEFTHOOK_VERSION=v2.1.16              # 2026-10-01
CADDY_VERSION=v2.11.7                 # 2026-10-03

# ShellCheck has no Go module: release tarball, verified by sha256 (Linux only;
# on macOS use `brew install shellcheck`).
SHELLCHECK_VERSION=v0.11.0            # 2025-08
SHELLCHECK_SHA256_x86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_aarch64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588

# Container images, tag for humans, digest for machines.
TERRAFORM_IMAGE=hashicorp/terraform:1.16.5@sha256:c7926feace05d0f7e73542842bf3945924e955a1f782cf000ccbb8d18fa42d77
TFLINT_IMAGE=ghcr.io/terraform-linters/tflint:v0.64.0@sha256:1c595f42d794c32c45a6ea8b58655fd66433d4ca3b1bc631c574a48d120bd19f
CHECKOV_IMAGE=bridgecrew/checkov:3.3.24@sha256:395ab21f8dc5d457f05001598638a98d142a98e264d610650c084d0ef2e1b4a5
TRIVY_IMAGE=aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa
ZAP_IMAGE=zaproxy/zap-stable:20261008@sha256:7aaa659b0d43078febd82e29bad112285c370727e86ab8340444220e17d9f0d2 # 2026-10-08 (D-88: 14 days)
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

# Local `act` runs only (scripts/ci/act.sh): the runner image for `runs-on: ubuntu-24.04`.
ACT_IMAGE=ghcr.io/catthehacker/ubuntu:act-24.04-20260815@sha256:62d572b92f9f32d3427b6d220ad1f9dca9c7b6ffad37d295425037dbff78abaf
