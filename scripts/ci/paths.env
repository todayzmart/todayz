# The one list of report paths CI uploads (W0-06 S3). Read by scripts/ci/collect-reports.sh,
# which the .github/actions/upload-reports composite action runs before uploading.
# shellcheck disable=SC2034 # read by collect-reports.sh
#
# Everything is copied into ci-reports/collected/ first, with a leading "." in any path
# part turned into "_", so the upload needs neither include-hidden-files nor a
# repo-wide **/ glob. Scanner reports are already in ci-reports/<scanner>/.

# Exact paths from the repo root (folders or files); missing ones are skipped.
CI_REPORT_PATHS="test-results .cache/dev/smoke .cache/dev/health.html"

# Folder names looked for directly inside each package folder below.
CI_REPORT_PACKAGES="customer business admin site e2e backend shared/ui shared/api-client shared/i18n shared/telemetry shared/config"
CI_REPORT_PACKAGE_DIRS="test-results playwright-report blob-report .lighthouseci coverage"

# QA evidence: only files under these folders that this run added or changed
# (per `git status`), never the whole committed docs/qa tree.
CI_REPORT_CHANGED="docs/qa"
